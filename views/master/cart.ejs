<!-- Hero Section Begin -->
<%- include("../partials/heroSection",{allCategories:allCategories}) %>
  <!-- Hero Section End -->
  <!-- Breadcrumb Section Begin -->
  <section class="breadcrumb-section set-bg" data-setbg="/img/breadcrumb.jpg">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center">
          <div class="breadcrumb__text">
            <h2>Shopping Cart</h2>
            <div class="breadcrumb__option">
              <a href="/">Home</a>
              <span>Shopping Cart</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Breadcrumb Section End -->

  <% if(locals.findCart?.products?.length>0){ %>
    <!-- Shoping Cart Section Begin -->
    <section class="shoping-cart spad">
      <div class="container">
        <div class="row">
          <div class="col-lg-12">
            <div class="shoping__cart__table">
              <table>
                <thead>
                  <tr>
                    <th class="shoping__product">Products</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% findCart.products.forEach(item=>{ %>
                    <tr id="cartItem-<%= item.productId.id %>" data-price="<%= item.price %>" data-offer-price="<%= item.offerPrice || '' %>">
                      <td class="shoping__cart__item">
                        <img
                          src="<%= item.productId.productImagePath[0].startsWith('http') ? item.productId.productImagePath[0] : '/files/' + item.productId.productImagePath[0] %>"
                          alt="" width="120" height="150" />
                        <a href="/product/<%=item.productId.id%>" class="text-dark">
                          <%= item.productId.name%>
                        </a>
                      </td>
                      <%if(item.offerPrice){%>
                        <td class="shoping__cart__price">
                          <del class="text-muted">Rs <%= item.price %></del>
                          Rs <%= item.offerPrice.toFixed(2) %>
                          <% if(item.productId && item.productId.isWholesaleSet) { %>
                            <br><span style="font-size: 14px; color: #b2b2b2;">piece cost: Rs <%= (item.offerPrice / item.productId.piecesPerSet).toFixed(2) %></span>
                            <br><span style="font-size: 14px; font-weight: bold;">Set Costs: Rs <%= item.offerPrice.toFixed(2) %></span>
                          <% } %>
                        </td>
                        <% }else{ %>
                          <td class="shoping__cart__price">
                            Rs <%= item.price %>
                            <% if(item.productId && item.productId.isWholesaleSet) { %>
                              <br><span style="font-size: 14px; color: #b2b2b2;">piece cost: Rs <%= (item.price / item.productId.piecesPerSet).toFixed(2) %></span>
                              <br><span style="font-size: 14px; font-weight: bold;">Set Costs: Rs <%= item.price.toFixed(2) %></span>
                            <% } %>
                          </td>
                          <% } %>
                            <td class="shoping__cart__quantity">
                              <div class="quantity">
                                <div class="pro-qty">
                                  <span class="dec qtybtn"
                                    onclick="addToCart('<%=item.productId.id%>','<%=item.name%>','<%=item.price%>',-1,'<%=item?.offerPrice%>')">-</span>
                                  <input type="text" id="currentQuantity-<%= item.productId.id %>"
                                    value="<%= item.quantity %>" data-current-quantity="<%= item.quantity %>"
                                    data-max-stock="<%= item.productId.quantity %>"
                                    data-delivery-charges="<%= item.productId.deliveryCharges || 0 %>"
                                    data-increase-delivery="<%= item.productId.increaseDeliveryChargesWithQuantity || false %>"
                                    data-delivery-tiers="<%= JSON.stringify(item.productId.deliveryChargeTiers || []) %>"
                                    data-is-free-delivery="<%= item.productId.isFreeDelivery || false %>"
                                    onchange="updateQuantity('<%=item.productId.id%>','<%=item.name%>','<%=item.price%>','<%=item?.offerPrice%>')" />
                                  <span class="inc qtybtn"
                                    onclick="addToCart('<%=item.productId.id%>','<%=item.name%>','<%=item.price%>',1,'<%=item?.offerPrice%>')">+</span>
                                </div>
                              </div>
                            </td>
                            <td class="shoping__cart__total" id="item-<%=item.productId.id %>">
                              <% const effPrice = (item.offerPrice && item.offerPrice > 0) ? item.offerPrice : item.price; %>
                              Rs <%= (effPrice * item.quantity).toFixed(2) %>
                                        <% // show per-item delivery charge %>
                                        <% let itemDelivery = 0; %>
                                        <% if (item.productId.isFreeDelivery) { %>
                                            <% itemDelivery = 0; %>
                                        <% } else if (item.productId.deliveryChargeTiers && item.productId.deliveryChargeTiers.length > 0) { %>
                                            <% itemDelivery = Number(item.productId.deliveryCharges || 0); %>
                                            <% for (let tier of item.productId.deliveryChargeTiers) {
                                                if (item.quantity >= tier.quantity) itemDelivery = Number(tier.charge);
                                                else break;
                                            } %>
                                        <% } else { %>
                                            <% const dCharge = Number(item.productId.deliveryCharges || 0); %>
                                            <% itemDelivery = item.productId.increaseDeliveryChargesWithQuantity ? (dCharge * item.quantity) : dCharge; %>
                                        <% } %>
                                        
                                        <% if (item.productId.isFreeDelivery) { %>
                                            <div class="text-success small" style="font-weight:bold;">FREE Delivery <i class="fa-solid fa-truck-fast"></i></div>
                                        <% } else if (itemDelivery && itemDelivery > 0) { %>
                                            <div class="text-muted small">Delivery: Rs <%= itemDelivery.toFixed(2) %>
                                                <% if (!item.productId.deliveryChargeTiers || item.productId.deliveryChargeTiers.length === 0) { %>
                                                    <% if (item.productId.increaseDeliveryChargesWithQuantity) { %> (per piece: Rs <%= Number(item.productId.deliveryCharges || 0).toFixed(2) %>)<% } %>
                                                <% } %>
                                            </div>
                                        <% } %>
                            </td>
                            <td class="shoping__cart__item__close">
                              <span class="icon_close" onclick="deleteItem('<%=item.productId.id %>')"></span>
                            </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-12">
            <div class="shoping__cart__btns">
              <a href="/" class="primary-btn cart-btn">CONTINUE SHOPPING</a>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="shoping__continue">
              <div class="shoping__discount">
                <h5>Discount Codes</h5>
                <form id="couponForm">
                  <input type="text" placeholder="Enter your coupon code" id="couponCode" value="<%= couponCode || '' %>" />
                  <button type="submit" id="applyCouponBtn" class="site-btn" style="<%= couponCode ? 'background-color: #28a745; border-color: #28a745; color: #ffffff;' : '' %>">APPLY COUPON</button>
                </form>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="shoping__checkout" id="checkoutBox">
              <h5>Cart Total</h5>
              <% const cDiscount = Number(couponDiscount || 0); %>
              <% const delCharges = Number(findCart.totalDeliveryCharges || 0); %>
              <% const cartSubTotal = Number(findCart.subTotal || 0); %>
              <% const cartGrandTotal = Math.max(0, cartSubTotal - cDiscount + delCharges); %>
              <ul id="total-list">
                <li>
                  Subtotal
                  <span>Rs <%= cartSubTotal.toFixed(2) %></span>
                </li>
                <li>
                  Cart Discount <span class="text-muted">Rs <%= cDiscount.toFixed(2) %></span>
                </li>
                <% if(couponCode){ %>
                  <li>
                    Coupon <span class="text-muted"><i class="fa-solid fa-tags"></i> <%= couponCode %> <i class="fa-solid fa-trash-can fa-xs trash" style="cursor:pointer; color:#dc3545;" onclick="removeCoupon()"></i></span>
                  </li>
                <% } %>
                <li>
                  Delivery Charges <span class="text-muted">Rs <%= delCharges.toFixed(2) %></span>
                </li>
                <li>
                  Total
                  <span>Rs <%= cartGrandTotal.toFixed(2) %></span>
                </li>
              </ul>
              <a href="/user/checkout" class="primary-btn">PROCEED TO CHECKOUT</a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Shoping Cart Section End -->
    <%} else {%>
      <section class="container">
        <div class="text-center py-5">
          <img src="/img/emptycart.png" alt="" />
          <div>
            <p class="h4">There is nothing in your bag. Let's add some items.</p>
          </div>
          <a href="/" class="primary-btn">Shop</a>
        </div>
      </section>
      <%}%>

        <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
        <script>
          // Initialize cart totals on page load
          document.addEventListener('DOMContentLoaded', function () {
            if (window.location.pathname === '/user/cart' || window.location.pathname === '/user/checkout') {
              updateCartTotals();
            }

            const couponInput = document.getElementById("couponCode");
            if (couponInput) {
              couponInput.addEventListener("input", function() {
                const btn = document.getElementById("applyCouponBtn") || document.querySelector("#couponForm button");
                if (btn) {
                  btn.style.backgroundColor = "";
                  btn.style.borderColor = "";
                  btn.style.color = "";
                }
              });
            }
          });

          document.forms["couponForm"].addEventListener("submit", async (event) => {
            event.preventDefault();
            const couponInput = document.getElementById("couponCode");
            const couponCode = (couponInput?.value || "").trim();
            const btn = document.getElementById("applyCouponBtn") || document.querySelector("#couponForm button");

            if (!couponCode) return;

            try {
              const response = await axios.post(`/user/redeem/${encodeURIComponent(couponCode)}`);
              if (response.status === 200) {
                if (btn) {
                  btn.style.backgroundColor = "#28a745";
                  btn.style.borderColor = "#28a745";
                  btn.style.color = "#ffffff";
                }
                $("#checkoutBox").load(location.href + " #checkoutBox>*", "", function() {
                  updateCartTotals();
                });
                celebrate();
                toastr.options = { "positionClass": "toast-bottom-right" };
                toastr.success(`Coupon applied successfully! You saved Rs ${response.data.couponDiscount}`);
              }
            } catch (err) {
              if (btn) {
                btn.style.backgroundColor = "#dc3545";
                btn.style.borderColor = "#dc3545";
                btn.style.color = "#ffffff";
              }
              const errorMsg = err.response?.data?.message || "Invalid coupon code";
              $("#checkoutBox").load(location.href + " #checkoutBox>*", "", function() {
                updateCartTotals();
              });
              toastr.options = { "positionClass": "toast-bottom-right" };
              toastr.error(errorMsg);
            }
          });

          async function removeCoupon() {
            try {
              await axios.delete("/user/removeCoupon");
              const btn = document.getElementById("applyCouponBtn") || document.querySelector("#couponForm button");
              if (btn) {
                btn.style.backgroundColor = "";
                btn.style.borderColor = "";
                btn.style.color = "";
              }
              const couponInput = document.getElementById("couponCode");
              if (couponInput) couponInput.value = "";
              $("#checkoutBox").load(location.href + " #checkoutBox>*", "", function() {
                updateCartTotals();
              });
              toastr.options = { "positionClass": "toast-bottom-right" };
              toastr.info("Coupon removed.");
            } catch (err) {
              console.error(err);
            }
          }

          //celebration
          function celebrate() {
            var count = 200;
            var defaults = {
              origin: { y: 0.7 }
            };

            function fire(particleRatio, opts) {
              confetti(Object.assign({}, defaults, opts, {
                particleCount: Math.floor(count * particleRatio)
              }));
            }

            fire(0.25, {
              spread: 26,
              startVelocity: 55,
            });
            fire(0.2, {
              spread: 60,
            });
            fire(0.35, {
              spread: 100,
              decay: 0.91,
              scalar: 0.8
            });
            fire(0.1, {
              spread: 120,
              startVelocity: 25,
              decay: 0.92,
              scalar: 1.2
            });
            fire(0.1, {
              spread: 120,
              startVelocity: 45,
            });
          }
        </script>