<style>
.payment-card {
  cursor: pointer;
  border: 2px solid #e2e8f0;
  border-radius: 10px;
  transition: all 0.2s ease-in-out;
}
.payment-card:hover {
  border-color: #cbd5e1;
  background-color: #f8fafc;
}
.payment-card:has(input:checked) {
  border-color: #0d6efd !important;
  background-color: #eff6ff !important;
  box-shadow: 0 4px 12px rgba(13, 110, 253, 0.12);
}
</style>

<div class="container-fluid px-4">
  <h1 class="mt-4">Add Order</h1>
  <%- include("../partials/errorMessage") %>
  
  <div class="card mb-4 mt-3">
    <div class="card-header">
      <i class="fas fa-plus me-1"></i>
      Create New Order
    </div>
    <div class="card-body">
      <form action="/admin/addOrder" method="POST" id="addOrderForm" onsubmit="return submitOrderForm(this)">
        
        <h5 class="mb-3"><i class="fas fa-box me-2"></i>Select Website Product</h5>
        <div class="row mb-3 align-items-end">
          <div class="col-md-6">
            <label class="form-label">Search / Select Product</label>
            <select id="productSelect" class="form-select product-select2">
              <option value="">Search product...</option>
              <% products.forEach(product => { %>
                <option value="<%= product.id %>" 
                  data-price="<%= product.offerPrice || product.price %>"
                  data-name="<%= product.name %>"
                  data-stock="<%= product.quantity %>"
                  data-delivery="<%= product.deliveryCharges || 0 %>"
                  data-delivery-increase="<%= product.increaseDeliveryChargesWithQuantity ? 'true' : 'false' %>">
                  <%= product.name %> - PKR <%= product.offerPrice || product.price %> (Stock: <%= product.quantity %>)
                </option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">Quantity</label>
            <input type="number" id="productQuantity" class="form-control" min="1" value="1">
          </div>
          <div class="col-md-4">
            <button type="button" class="btn btn-outline-dark w-100" onclick="addProductToTable()">
              <i class="fas fa-cart-plus me-1"></i> Add Website Product
            </button>
          </div>
        </div>

        <!-- Manual Custom Product Entry Section -->
        <div class="card mb-3" style="background-color: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 10px;">
          <div class="card-body p-3">
            <div class="d-flex align-items-center mb-2">
              <i class="fas fa-edit text-primary me-2"></i>
              <strong class="text-dark" style="font-size: 0.95rem;">Manual / Custom Product Entry</strong>
              <span class="badge bg-secondary ms-2" style="font-size: 0.72rem; font-weight: 500;">For products not on website</span>
            </div>
            <div class="row g-2 align-items-end">
              <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Item Name <span class="text-danger">*</span></label>
                <input type="text" id="manualItemName" class="form-control form-control-sm" placeholder="e.g. Kurti / Lawn Suit">
              </div>
              <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Category <span class="text-muted small">(Optional)</span></label>
                <select id="manualCategory" class="form-select form-select-sm">
                  <option value="">Select Category...</option>
                  <% if (typeof allCategories !== 'undefined' && allCategories) { %>
                    <% allCategories.forEach(cat => { %>
                      <option value="<%= cat.categoryName %>"><%= cat.categoryName %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Pieces <span class="text-muted small">(Optional)</span></label>
                <select id="manualPieces" class="form-select form-select-sm">
                  <option value="">-- None --</option>
                  <option value="1pc">1pc</option>
                  <option value="2pc">2pc</option>
                  <option value="3pc">3pc</option>
                  <option value="4pc">4pc</option>
                  <option value="5pc">5pc</option>
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Price (PKR) <span class="text-danger">*</span></label>
                <input type="number" id="manualPrice" class="form-control form-control-sm" placeholder="e.g. 2500" min="0">
              </div>
              <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Discount Price <span class="text-muted small">(Optional)</span></label>
                <input type="number" id="manualDiscountPrice" class="form-control form-control-sm" placeholder="e.g. 2200" min="0">
              </div>
              <div class="col-md-1">
                <label class="form-label small fw-bold mb-1">Qty <span class="text-danger">*</span></label>
                <input type="number" id="manualQuantity" class="form-control form-control-sm" min="1" value="1">
              </div>
              <div class="col-12 text-end mt-2">
                <button type="button" class="btn btn-sm btn-dark px-3" onclick="addManualProductToTable()">
                  <i class="fas fa-plus me-1"></i> Add to Order
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="table-responsive mb-4">
          <table class="table table-bordered" id="orderProductsTable">
            <thead class="table-light">
              <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Delivery</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <tr id="emptyRow">
                <td colspan="6" class="text-center text-muted">No products added yet</td>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <th colspan="3" class="text-end">Product Total:</th>
                <th>PKR <span id="productTotal">0.00</span></th>
                <th></th>
                <th></th>
              </tr>
              <tr>
                <th colspan="3" class="text-end">Delivery Charges:</th>
                <th>PKR <span id="deliveryTotal">0.00</span></th>
                <th></th>
                <th></th>
              </tr>
              <tr class="table-dark">
                <th colspan="3" class="text-end">Grand Total:</th>
                <th>PKR <span id="grandTotal">0.00</span></th>
                <th></th>
                <th></th>
              </tr>
            </tfoot>
          </table>
        </div>

        <hr>
        <h5 class="mb-3"><i class="fas fa-user me-2"></i>Customer Information</h5>
        <div class="row mb-4">
          <div class="col-md-6 mb-3">
            <label class="form-label">Email <span class="text-muted">(Optional)</span></label>
            <input type="email" name="email" class="form-control" placeholder="customer@example.com">
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Phone <span class="text-danger">*</span></label>
            <input type="text" name="phone" class="form-control" required>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">First Name <span class="text-danger">*</span></label>
            <input type="text" name="firstName" class="form-control" required>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Last Name <span class="text-danger">*</span></label>
            <input type="text" name="lastName" class="form-control" required>
          </div>
          <div class="col-md-12 mb-3">
            <label class="form-label">Address <span class="text-danger">*</span></label>
            <input type="text" name="address" class="form-control" required>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">City <span class="text-danger">*</span></label>
            <input type="text" name="city" class="form-control" required>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Province <span class="text-danger">*</span></label>
            <select name="province" class="form-select" required>
              <option value="">Select Province...</option>
              <option value="Punjab">Punjab</option>
              <option value="Sindh">Sindh</option>
              <option value="KPK">Khyber Pakhtunkhwa (KPK)</option>
              <option value="Balochistan">Balochistan</option>
              <option value="Islamabad">Islamabad Capital Territory</option>
              <option value="Gilgit-Baltistan">Gilgit-Baltistan</option>
              <option value="AJK">Azad Jammu & Kashmir</option>
            </select>
          </div>
        </div>

        <hr>
        <h5 class="mb-3"><i class="fas fa-credit-card me-2"></i>Payment Method <span class="text-danger">*</span></h5>
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label class="card h-100 p-3 payment-card" for="payCod">
              <div class="d-flex align-items-center">
                <input type="radio" name="paymentType" value="cod" class="form-check-input me-3 fs-5" id="payCod" required>
                <div>
                  <div class="fw-bold text-dark d-flex align-items-center">
                    <i class="fas fa-hand-holding-dollar text-warning me-2 fs-5"></i> Cash On Delivery (COD)
                  </div>
                  <div class="text-muted small mt-1">Payment collected in cash upon parcel delivery</div>
                </div>
              </div>
            </label>
          </div>
          <div class="col-md-4">
            <label class="card h-100 p-3 payment-card" for="payOnline">
              <div class="d-flex align-items-center">
                <input type="radio" name="paymentType" value="online_paid" class="form-check-input me-3 fs-5" id="payOnline" required>
                <div>
                  <div class="fw-bold text-dark d-flex align-items-center">
                    <i class="fas fa-circle-check text-success me-2 fs-5"></i> Online Payment
                  </div>
                  <div class="text-muted small mt-1">Paid in advance via Bank / EasyPaisa / JazzCash</div>
                </div>
              </div>
            </label>
          </div>
        </div>

        <!-- Hidden inputs -->
        <input type="hidden" name="orderProducts" id="orderProductsInput" required>

        <div class="text-end mt-4">
          <a href="/admin/orders" class="btn btn-secondary me-2">Cancel</a>
          <button type="submit" class="btn btn-dark" id="submitOrderBtn">
            <i class="fas fa-check me-1"></i> Create Order
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  let orderItems = [];
  let productsData = {};

  // Build a lookup of products for stock/delivery data
  <% products.forEach(product => { %>
    productsData['<%= product.id %>'] = {
      stock: <%= product.quantity %>,
      delivery: <%= product.deliveryCharges || 0 %>,
      increaseWithQty: <%= product.increaseDeliveryChargesWithQuantity ? 'true' : 'false' %>
    };
  <% }) %>

  $(document).ready(function() {
    $('.product-select2').select2({
      theme: 'bootstrap-5',
      width: '100%'
    });
  });

  function addProductToTable() {
    const select = document.getElementById('productSelect');
    const qtyInput = document.getElementById('productQuantity');
    
    if (!select.value) {
      alert("Please select a product");
      return;
    }
    
    const productId = select.value;
    const qty = parseInt(qtyInput.value);
    const pData = productsData[productId];
    
    if (qty < 1 || isNaN(qty)) {
      alert("Quantity must be at least 1");
      return;
    }

    // Check stock limit
    const existingItem = orderItems.find(item => item.productId === productId);
    const existingQty = existingItem ? existingItem.quantity : 0;
    if (existingQty + qty > pData.stock) {
      alert(`Cannot add ${qty} more. Only ${pData.stock - existingQty} left in stock.`);
      return;
    }

    if (existingItem) {
      existingItem.quantity += qty;
    } else {
      const selectedOption = select.options[select.selectedIndex];
      const price = parseFloat(selectedOption.getAttribute('data-price'));
      const name = selectedOption.getAttribute('data-name');
      
      orderItems.push({
        productId: productId,
        isManual: false,
        name: name,
        price: price,
        effectivePrice: price,
        quantity: qty,
        delivery: pData.delivery,
        increaseWithQty: pData.increaseWithQty
      });
    }

    renderTable();
    $('#productSelect').val(null).trigger('change');
    qtyInput.value = 1;
  }

  function addManualProductToTable() {
    const nameInput = document.getElementById('manualItemName');
    const catInput = document.getElementById('manualCategory');
    const pieceInput = document.getElementById('manualPieces');
    const priceInput = document.getElementById('manualPrice');
    const discPriceInput = document.getElementById('manualDiscountPrice');
    const qtyInput = document.getElementById('manualQuantity');

    const name = nameInput.value.trim();
    const price = parseFloat(priceInput.value);
    const discPrice = parseFloat(discPriceInput.value) || 0;
    const qty = parseInt(qtyInput.value);
    const category = catInput.value;
    const pieceType = pieceInput.value;

    if (!name) {
      alert("Please enter the custom item name.");
      nameInput.focus();
      return;
    }
    if (isNaN(price) || price < 0) {
      alert("Please enter a valid price.");
      priceInput.focus();
      return;
    }
    if (isNaN(qty) || qty < 1) {
      alert("Quantity must be at least 1.");
      qtyInput.focus();
      return;
    }

    const effectivePrice = (discPrice > 0) ? discPrice : price;

    orderItems.push({
      productId: 'manual_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
      isManual: true,
      name: name,
      category: category,
      pieceType: pieceType,
      price: price,
      discountedPrice: discPrice > 0 ? discPrice : 0,
      effectivePrice: effectivePrice,
      quantity: qty,
      delivery: 0,
      increaseWithQty: false
    });

    renderTable();

    // Clear input fields
    nameInput.value = '';
    catInput.value = '';
    pieceInput.value = '';
    priceInput.value = '';
    discPriceInput.value = '';
    qtyInput.value = '1';
  }

  function removeProduct(index) {
    orderItems.splice(index, 1);
    renderTable();
  }

  function renderTable() {
    const tbody = document.querySelector('#orderProductsTable tbody');
    tbody.innerHTML = '';
    
    let productTotal = 0;
    let deliveryTotal = 0;

    if (orderItems.length === 0) {
      tbody.innerHTML = '<tr id="emptyRow"><td colspan="6" class="text-center text-muted">No products added yet</td></tr>';
      document.getElementById('productTotal').innerText = '0.00';
      document.getElementById('deliveryTotal').innerText = '0.00';
      document.getElementById('grandTotal').innerText = '0.00';
      document.getElementById('orderProductsInput').value = '';
      return;
    }

    orderItems.forEach((item, index) => {
      const unitPrice = item.effectivePrice || item.price;
      const subtotal = unitPrice * item.quantity;
      productTotal += subtotal;
      
      let deliveryCharge = item.delivery || 0;
      if (item.increaseWithQty) {
        deliveryCharge = deliveryCharge * item.quantity;
      }
      deliveryTotal += deliveryCharge;

      let displayName = item.name;
      if (item.pieceType) {
        displayName += ` <span class="badge bg-light text-dark border">${item.pieceType}</span>`;
      }
      if (item.category) {
        displayName += ` <small class="text-muted">(${item.category})</small>`;
      }
      if (item.isManual) {
        displayName += ` <span class="badge bg-secondary" style="font-size:0.68rem;">Custom</span>`;
      }

      let priceHtml = `PKR ${item.price.toFixed(2)}`;
      if (item.discountedPrice && item.discountedPrice > 0) {
        priceHtml = `<del class="text-muted small">PKR ${item.price.toFixed(2)}</del> <span class="text-success fw-bold">PKR ${item.discountedPrice.toFixed(2)}</span>`;
      }
      
      tbody.innerHTML += `
        <tr>
          <td>${displayName}</td>
          <td>${priceHtml}</td>
          <td>${item.quantity}</td>
          <td>PKR ${subtotal.toFixed(2)}</td>
          <td>PKR ${deliveryCharge.toFixed(2)}</td>
          <td class="text-center">
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeProduct(${index})">
              <i class="fa-solid fa-trash"></i>
            </button>
          </td>
        </tr>
      `;
    });

    const grandTotal = productTotal + deliveryTotal;
    document.getElementById('productTotal').innerText = productTotal.toFixed(2);
    document.getElementById('deliveryTotal').innerText = deliveryTotal.toFixed(2);
    document.getElementById('grandTotal').innerText = grandTotal.toFixed(2);
    document.getElementById('orderProductsInput').value = JSON.stringify(orderItems);
  }

  function submitOrderForm(form) {
    if (orderItems.length === 0) {
      alert("Please add at least one product to the order.");
      return false;
    }
    const paymentSelected = form.querySelector('input[name="paymentType"]:checked');
    if (!paymentSelected) {
      alert("Please select a payment method (COD or Online Payment).");
      return false;
    }
    const btn = document.getElementById('submitOrderBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Submitting...';
    return true;
  }
</script>
