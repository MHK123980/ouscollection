<!-- =========================================================
     CREATE BARCODE  –  QR Label Generator
     Requires: Bootstrap 5, FontAwesome 6 (from layout)
     ========================================================= -->

<!-- QRCode.js CDN (back to QR) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<style>
  /* ---- Page ---- */
  #barcode-page { max-width: 900px; margin: 0 auto; }

  /* ---- Labels grid ---- */
  #labels-area {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 14px;
    background: #f4f4f4;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    min-height: 80px;
  }

  /* ── 2×1 label: 38mm wide × 25mm tall ──
     Side-by-side layout: [QR | text]          */
  .qr-label {
    width:  144px;   /* ≈38mm @96dpi */
    height:  96px;   /* ≈25mm @96dpi */
    background: #fff;
    border: 1px solid #bbb;
    border-radius: 3px;
    display: flex;
    flex-direction: row;      /* ← side by side */
    align-items: center;
    padding: 2px;
    box-sizing: border-box;
    page-break-inside: avoid;
    break-inside: avoid;
    overflow: hidden;
    gap: 4px;
  }

  /* LEFT side: QR code */
  .qr-label .label-qr-wrap {
    flex: 0 0 auto;
    width:  60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .qr-label .label-qr-wrap img,
  .qr-label .label-qr-wrap canvas {
    width:  60px !important;
    height: 60px !important;
  }

  /* RIGHT side: text info */
  .qr-label .label-text {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    overflow: hidden;
  }

  .qr-label .label-name {
    font-size: 10px;
    font-weight: 700;
    color: #000;
    word-break: break-word;
    line-height: 1.1;
    max-height: 33px; /* limit to 3 lines */
    overflow: hidden;
  }

  .qr-label .label-price {
    font-size: 11px;
    font-weight: 900;
    color: #000;
  }

  .qr-label .label-disc {
    font-size: 9px;
    color: #c00;
    text-decoration: line-through;
  }

  .qr-label .label-piece {
    font-size: 8px;
    color: #444;
  }

  /* Empty placeholder */
  #labels-placeholder {
    width: 100%;
    text-align: center;
    color: #aaa;
    font-size: .9rem;
    padding: 20px;
  }

  /* ---- PRINT STYLES ---- */
  @media print {
    body * { visibility: hidden !important; }

    @page { margin: 0; }

    #labels-area, #labels-area * { visibility: visible !important; }
    #labels-area {
      position: fixed !important;
      top: 0; left: 0;
      width: 80mm !important;    /* 2-up thermal roll */
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      gap: 0 !important;
      margin: 0 !important;
      display: flex !important;
      flex-wrap: wrap !important;
    }

    .qr-label {
      width:  38mm !important;
      height: 25mm !important;
      border: none !important;
      padding: 1mm !important;
      margin: 0 !important;
      border-radius: 0 !important;
      gap: 1mm !important;
      float: left !important;
    }

    .qr-label .label-qr-wrap {
      width:  16mm !important;
      height: 16mm !important;
    }
    .qr-label .label-qr-wrap img,
    .qr-label .label-qr-wrap canvas {
      width:  16mm !important;
      height: 16mm !important;
    }

    .qr-label .label-name  { font-size: 7pt !important; }
    .qr-label .label-price { font-size: 8pt !important; }
    .qr-label .label-disc  { font-size: 6pt !important; }
    .qr-label .label-piece { font-size: 6pt !important; }
  }
</style>

<div id="barcode-page" class="container-fluid py-3">

  <!-- Header -->
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="mb-0 fw-bold">
      <i class="fa-solid fa-qrcode me-2 text-primary"></i>Create QR Labels
    </h4>
  </div>

  <!-- ===== FORM ===== -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white py-2">
      <i class="fa-solid fa-sliders me-2"></i>Label Details
    </div>
    <div class="card-body">
      <div class="row g-3 align-items-end">

        <!-- Item Name -->
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label fw-semibold small" for="b-name">Item Name</label>
          <input type="text" class="form-control" id="b-name" placeholder="e.g. Zellbury Shirt">
        </div>

        <!-- Category -->
        <div class="col-12 col-sm-6 col-md-2">
          <label class="form-label fw-semibold small" for="b-category">Category</label>
          <select class="form-select" id="b-category">
            <option value="">-- Select --</option>
            <% if (typeof allCategories !== 'undefined' && allCategories.length) { %>
              <% allCategories.forEach(function(cat){ %>
                <option value="<%= cat.categoryName %>"><%= cat.categoryName %></option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Price -->
        <div class="col-6 col-sm-4 col-md-2">
          <label class="form-label fw-semibold small" for="b-price">Price</label>
          <input type="number" class="form-control" id="b-price" placeholder="0" min="0" step="0.01">
        </div>

        <!-- Discounted Price -->
        <div class="col-6 col-sm-4 col-md-2">
          <label class="form-label fw-semibold small" for="b-disc">Discounted Price</label>
          <input type="number" class="form-control" id="b-disc" placeholder="0" min="0" step="0.01">
        </div>

        <!-- Piece Type -->
        <div class="col-6 col-sm-4 col-md-1">
          <label class="form-label fw-semibold small" for="b-piece">Piece</label>
          <select class="form-select" id="b-piece">
            <option value="">--</option>
            <% ['1pc','2pc','3pc','4pc','5pc','6pc','7pc','8pc','9pc','10pc'].forEach(function(p){ %>
              <option value="<%= p %>"><%= p %></option>
            <% }); %>
          </select>
        </div>

        <!-- Copies -->
        <div class="col-6 col-sm-4 col-md-1">
          <label class="form-label fw-semibold small" for="b-copies">Copies</label>
          <input type="number" class="form-control" id="b-copies" value="1" min="1" max="100">
        </div>

        <!-- Generate Button -->
        <div class="col-12 col-md-1 d-flex align-items-end">
          <button class="btn btn-primary w-100" id="btn-generate" type="button">
            <i class="fa-solid fa-qrcode me-1"></i>Generate
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- ===== LABELS OUTPUT ===== -->
  <div class="d-flex align-items-center justify-content-between mb-2">
    <h6 class="mb-0 fw-bold text-secondary">
      <i class="fa-solid fa-tags me-1"></i>Generated Labels
      <span class="badge bg-secondary ms-1" id="label-count">0</span>
    </h6>
    <button class="btn btn-success btn-sm" id="btn-print-labels" style="display:none;" type="button">
      <i class="fa-solid fa-print me-1"></i>Print Labels
    </button>
  </div>

  <div id="labels-area">
    <div id="labels-placeholder">
      <i class="fa-solid fa-qrcode fa-2x mb-2 d-block text-muted"></i>
      Generated labels will appear here
    </div>
  </div>

</div><!-- /barcode-page -->

<!-- ===== PAGE SCRIPT ===== -->
<script>
(function () {
  'use strict';

  const btnGenerate = document.getElementById('btn-generate');
  const btnPrint    = document.getElementById('btn-print-labels');
  const labelsArea  = document.getElementById('labels-area');
  const labelCount  = document.getElementById('label-count');
  const placeholder = document.getElementById('labels-placeholder');

  /* ------------------------------------------------------------------ */
  /*  BUILD QR PAYLOAD  (BCODE:<num>|<json> so scanner in createBill     */
  /*  can still parse it correctly)                                       */
  /* ------------------------------------------------------------------ */
  function genCode() {
    return String(Math.floor(10000000 + Math.random() * 90000000));
  }

  function buildPayload(code, name, category, price, discountedPrice, pieceType) {
    const obj = {};
    if (name)               obj.n  = name;
    if (category)           obj.c  = category;
    if (price > 0)          obj.p  = price;
    if (discountedPrice > 0) obj.d = discountedPrice;
    if (pieceType)          obj.pt = pieceType;
    return 'BCODE:' + code + '|' + JSON.stringify(obj);
  }

  /* ------------------------------------------------------------------ */
  /*  CREATE SINGLE LABEL                                                 */
  /*  Layout: [QR code | name + price]  side-by-side                     */
  /* ------------------------------------------------------------------ */
  function createLabel(payload, name, price, discountedPrice, pieceType) {
    const label = document.createElement('div');
    label.className = 'qr-label';

    /* --- LEFT: QR container --- */
    const qrWrap = document.createElement('div');
    qrWrap.className = 'label-qr-wrap';
    label.appendChild(qrWrap);

    /* --- RIGHT: text info --- */
    const textDiv = document.createElement('div');
    textDiv.className = 'label-text';

    if (name) {
      const nameEl = document.createElement('div');
      nameEl.className = 'label-name';
      nameEl.textContent = name;
      textDiv.appendChild(nameEl);
    }

    if (discountedPrice > 0) {
      const discEl = document.createElement('div');
      discEl.className = 'label-disc';
      discEl.textContent = 'Rs ' + parseFloat(price).toFixed(0);
      textDiv.appendChild(discEl);

      const priceEl = document.createElement('div');
      priceEl.className = 'label-price';
      priceEl.textContent = 'Rs ' + parseFloat(discountedPrice).toFixed(0);
      textDiv.appendChild(priceEl);
    } else if (price > 0) {
      const priceEl = document.createElement('div');
      priceEl.className = 'label-price';
      priceEl.textContent = 'Rs ' + parseFloat(price).toFixed(0);
      textDiv.appendChild(priceEl);
    }

    if (pieceType) {
      const pieceEl = document.createElement('div');
      pieceEl.className = 'label-piece';
      pieceEl.textContent = pieceType;
      textDiv.appendChild(pieceEl);
    }

    label.appendChild(textDiv);

    /* Generate QR into qrWrap after DOM tick */
    setTimeout(function () {
      try {
        new QRCode(qrWrap, {
          text: payload,
          width:  60,
          height: 60,
          correctLevel: QRCode.CorrectLevel.M
        });
      } catch (e) {
        qrWrap.innerHTML = '<span style="font-size:9px;color:red;">QR Error</span>';
        console.error('QR error:', e);
      }
    }, 0);

    return label;
  }

  /* ------------------------------------------------------------------ */
  /*  GENERATE BUTTON                                                     */
  /* ------------------------------------------------------------------ */
  btnGenerate.addEventListener('click', function () {
    const name          = document.getElementById('b-name').value.trim();
    const category      = document.getElementById('b-category').value;
    const price         = parseFloat(document.getElementById('b-price').value) || 0;
    const discountedPrice = parseFloat(document.getElementById('b-disc').value) || 0;
    const pieceType     = document.getElementById('b-piece').value;
    const copies        = Math.min(100, Math.max(1, parseInt(document.getElementById('b-copies').value) || 1));

    labelsArea.innerHTML = '';
    placeholder.style.display = 'none';

    const code    = genCode();
    const payload = buildPayload(code, name, category, price, discountedPrice, pieceType);

    for (let i = 0; i < copies; i++) {
      labelsArea.appendChild(createLabel(payload, name, price, discountedPrice, pieceType));
    }

    labelCount.textContent = copies;
    btnPrint.style.display = copies > 0 ? 'inline-block' : 'none';
    labelsArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* ------------------------------------------------------------------ */
  /*  PRINT BUTTON                                                        */
  /* ------------------------------------------------------------------ */
  btnPrint.addEventListener('click', function () { window.print(); });

  /* Enter key triggers generate */
  ['b-name','b-price','b-disc','b-copies'].forEach(function (id) {
    const el = document.getElementById(id);
    if (el) el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') btnGenerate.click();
    });
  });

})();
</script>
