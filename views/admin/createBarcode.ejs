<!-- =========================================================
     CREATE BARCODE  –  QR Label Generator (Perfect Crop & Print Fix)
     ========================================================= -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<style>
  /* ---- Page ---- */
  #barcode-page { max-width: 680px; margin: 0 auto; padding-bottom: 60px; }

  /* ---- Preset chips ---- */
  .preset-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .preset-chip {
    position: relative; display: inline-flex; align-items: center;
    padding: 6px 16px; border-radius: 20px; border: 2px solid #dee2e6;
    background: #fff; font-size: 13px; font-weight: 600; cursor: pointer;
    user-select: none; -webkit-user-select: none; touch-action: none;
    transition: border-color .15s, background .15s;
  }
  .preset-chip.active { border-color: #0d6efd; background: #e8f0fe; color: #0d6efd; }
  .preset-chip.holding { border-color: #dc3545; background: #fdecea; }
  .preset-chip .hold-bar {
    position: absolute; bottom: 0; left: 0; height: 3px; width: 0%;
    background: #dc3545; border-radius: 0 0 20px 20px; transition: none;
  }
  .preset-add-btn {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 6px 14px; border-radius: 20px; border: 2px dashed #adb5bd;
    background: transparent; font-size: 13px; color: #6c757d; cursor: pointer;
  }
  .preset-add-btn:hover { border-color: #0d6efd; color: #0d6efd; }

  /* ---- Preview area ---- */
  #preview-wrap {
    background: #e9e9e9; border: 1px solid #ccc;
    border-radius: 8px; padding: 12px; overflow-x: auto;
  }
  #preview-col { display: flex; flex-direction: column; align-items: flex-start; }

  /* ---- Preview label ---- */
  .prev-lbl {
    background: #fff; border: 1px solid #bbb; border-radius: 2px;
    display: flex; flex-direction: row; align-items: center;
    overflow: hidden; box-sizing: border-box;
  }
  .prev-lbl .qw { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; }
  .prev-lbl .qw img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .prev-lbl .tx {
    flex: 1 1 auto; display: flex; flex-direction: column;
    justify-content: center; overflow: hidden; padding-right: 3px; line-height: 1.15;
  }
  .prev-lbl .nm { font-weight: 700; color: #000; word-break: break-word; }
  .prev-lbl .pr { font-weight: 900; color: #000; }
  .prev-lbl .dc { color: #c00; text-decoration: line-through; }
  .prev-lbl .pc { color: #444; }
</style>

<!-- Hidden div for generating and cropping QR -->
<div id="hidden-qr-gen" style="position: absolute; left: -9999px; top: -9999px;"></div>

<div id="barcode-page" class="container-fluid py-3">

  <div class="d-flex align-items-center mb-3">
    <h4 class="mb-0 fw-bold">
      <i class="fa-solid fa-qrcode me-2 text-primary"></i>Create QR Labels
    </h4>
  </div>

  <!-- LABEL DETAILS FORM -->
  <div class="card shadow-sm mb-3">
    <div class="card-header bg-dark text-white py-2">
      <i class="fa-solid fa-sliders me-2"></i>Label Details
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12">
          <label class="form-label fw-semibold small" for="b-name">Item Name</label>
          <input type="text" class="form-control" id="b-name" placeholder="e.g. Zellbury Shirt">
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold small" for="b-category">Category</label>
          <select class="form-select" id="b-category">
            <option value="">-- Select --</option>
            <% if (typeof allCategories !== 'undefined' && allCategories.length) { %>
              <% allCategories.forEach(function(cat){ %>
                <option value="<%= cat.categoryName %>"><%= cat.categoryName %></option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <div class="col-6">
          <label class="form-label fw-semibold small" for="b-price">Price (Rs)</label>
          <input type="number" class="form-control" id="b-price" placeholder="0" min="0" step="1">
        </div>
        <div class="col-6">
          <label class="form-label fw-semibold small" for="b-disc">Discounted Price</label>
          <input type="number" class="form-control" id="b-disc" placeholder="0" min="0" step="1">
        </div>
        <div class="col-6">
          <label class="form-label fw-semibold small" for="b-piece">Piece Type</label>
          <select class="form-select" id="b-piece">
            <option value="">--</option>
            <% ['1pc','2pc','3pc','4pc','5pc','6pc','7pc','8pc','9pc','10pc'].forEach(function(p){ %>
              <option value="<%= p %>"><%= p %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-6">
          <label class="form-label fw-semibold small" for="b-copies">No. of Labels</label>
          <input type="number" class="form-control" id="b-copies" value="1" min="1" max="200">
        </div>
        <div class="col-12">
          <button class="btn btn-primary w-100 py-2" id="btn-generate" type="button">
            <i class="fa-solid fa-qrcode me-2"></i>Generate Labels
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- PRINT SETTINGS -->
  <div class="card shadow-sm mb-3" id="print-card" style="display:none;">
    <div class="card-header bg-secondary text-white py-2">
      <i class="fa-solid fa-print me-2"></i>Print Settings
    </div>
    <div class="card-body">

      <!-- Size Presets -->
      <label class="form-label fw-semibold small mb-1">
        Label Size
        <span class="text-muted fw-normal ms-1" style="font-size:11px;">(hold 2s to delete custom)</span>
      </label>
      <div class="preset-row" id="preset-row"></div>
      <button class="preset-add-btn mt-2" id="btn-add-preset" type="button">
        <i class="fa-solid fa-plus"></i> Add Custom Size
      </button>

      <!-- Custom size inputs -->
      <div id="custom-inputs" class="row g-2 mt-2" style="display:none;">
        <div class="col-4">
          <input type="number" class="form-control form-control-sm" id="cw" placeholder="Width (in)" step="0.1" min="0.5">
        </div>
        <div class="col-4">
          <input type="number" class="form-control form-control-sm" id="ch" placeholder="Height (in)" step="0.1" min="0.5">
        </div>
        <div class="col-4">
          <button class="btn btn-success btn-sm w-100" id="btn-save-preset" type="button">
            <i class="fa-solid fa-check"></i> Save
          </button>
        </div>
        <div class="col-12">
          <input type="text" class="form-control form-control-sm" id="cn" placeholder="Name (optional, e.g. My Label)">
        </div>
      </div>

      <!-- Gap -->
      <div class="mb-3 mt-3">
        <label class="form-label fw-semibold small" for="lbl-gap">Gap Between Labels</label>
        <div class="input-group input-group-sm">
          <input type="number" class="form-control" id="lbl-gap" value="0.125" min="0" max="1" step="0.0625">
          <span class="input-group-text">inch</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="d-flex gap-2">
        <button class="btn btn-success flex-grow-1 py-2" id="btn-print" type="button">
          <i class="fa-solid fa-print me-2"></i>Print
        </button>
        <button class="btn btn-danger flex-grow-1 py-2" id="btn-pdf" type="button">
          <i class="fa-solid fa-file-pdf me-2"></i>Save PDF
        </button>
      </div>

      <!-- Instructions -->
      <div class="alert alert-info mt-3 mb-0 py-2 px-3" style="font-size:12px;">
        <i class="fa-solid fa-circle-info me-1"></i>
        <strong>Note on Paper Size:</strong> Mobile browsers default to A4 size. Once the print dialog opens, tap on the printer name at the top to select your Label Printer. The size will auto-adjust.
      </div>

    </div>
  </div>

  <!-- PREVIEW -->
  <div id="preview-section" style="display:none;">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <h6 class="mb-0 fw-bold text-secondary">
        <i class="fa-solid fa-eye me-1"></i>Preview
        <span class="badge bg-secondary ms-1" id="lbl-count">0</span>
        <small class="text-muted fw-normal ms-2" id="size-info"></small>
      </h6>
    </div>
    <div id="preview-wrap">
      <div id="preview-col"></div>
    </div>
  </div>

</div>

<!-- ========================= SCRIPT ========================= -->
<script>
(function(){
'use strict';

const PX = 96; // CSS px per inch for screen preview
const LS_KEY = 'bcPresets_v3';

/* ── Built-in presets ── */
const BUILTIN = [
  { id:'bi_2x1', label:'2×1 in', w:2, h:1, builtin:true },
  { id:'bi_2x2', label:'2×2 in', w:2, h:2, builtin:true },
];

/* ── State ── */
let activePreset = BUILTIN[0];
let payload = null, labelData = {}, copies = 0;
let croppedQRBase64 = null; // Perfect QR with no whitespace

/* ── DOM ── */
const D = id => document.getElementById(id);
const presetRow   = D('preset-row');
const btnAddPre   = D('btn-add-preset');
const customInputs= D('custom-inputs');
const btnSavePre  = D('btn-save-preset');
const lblGap      = D('lbl-gap');
const btnGenerate = D('btn-generate');
const btnPrint    = D('btn-print');
const btnPdf      = D('btn-pdf');
const printCard   = D('print-card');
const previewSec  = D('preview-section');
const previewCol  = D('preview-col');

/* ================================================================
   PERFECT CROP QR GENERATOR (Removes all whitespace)
================================================================ */
function generateCroppedQR(text, callback) {
  const genDiv = D('hidden-qr-gen');
  genDiv.innerHTML = '';
  new QRCode(genDiv, { text: text, width: 250, height: 250, correctLevel: QRCode.CorrectLevel.M });
  
  setTimeout(() => {
    const canvas = genDiv.querySelector('canvas');
    if (!canvas) return callback('');
    
    const ctx = canvas.getContext('2d');
    const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const data = imgData.data;
    
    let minX = canvas.width, minY = canvas.height, maxX = 0, maxY = 0;
    
    // Find non-white pixels
    for (let y = 0; y < canvas.height; y++) {
      for (let x = 0; x < canvas.width; x++) {
        const i = (y * canvas.width + x) * 4;
        if (data[i] < 250 || data[i+1] < 250 || data[i+2] < 250) {
          if (x < minX) minX = x;
          if (y < minY) minY = y;
          if (x > maxX) maxX = x;
          if (y > maxY) maxY = y;
        }
      }
    }
    
    const w = maxX - minX + 1;
    const h = maxY - minY + 1;
    
    const cropCanvas = document.createElement('canvas');
    cropCanvas.width = w;
    cropCanvas.height = h;
    const cropCtx = cropCanvas.getContext('2d');
    
    // Draw cropped region with a tiny 2px white border so it looks clean
    cropCtx.fillStyle = '#ffffff';
    cropCtx.fillRect(0, 0, w, h);
    cropCtx.putImageData(ctx.getImageData(minX, minY, w, h), 0, 0);
    
    callback(cropCanvas.toDataURL('image/png'));
  }, 100);
}

/* ================================================================
   PRESETS
================================================================ */
function getCustom(){ try{ return JSON.parse(localStorage.getItem(LS_KEY)||'[]'); }catch{ return []; } }
function saveCustom(arr){ localStorage.setItem(LS_KEY, JSON.stringify(arr)); }
function allPresets(){ return [...BUILTIN, ...getCustom()]; }

let holdRaf=null, holdStart=0;

function renderPresets(){
  presetRow.innerHTML='';
  allPresets().forEach(p=>{
    const chip = document.createElement('span');
    chip.className = 'preset-chip' + (p.id===activePreset.id?' active':'');
    chip.dataset.id = p.id;
    chip.innerHTML  = p.label + (p.builtin?'':'<span class="hold-bar"></span>');

    chip.addEventListener('click', ()=>{
      activePreset = allPresets().find(x=>x.id===p.id)||BUILTIN[0];
      renderPresets(); refreshPreview();
    });

    if(!p.builtin){
      let timer=null, bar=chip.querySelector('.hold-bar');
      const startH = e => {
        e.preventDefault(); holdStart = Date.now(); chip.classList.add('holding');
        const tick = ()=>{
          const pct = Math.min(100,(Date.now()-holdStart)/2000*100);
          if(bar) bar.style.width=pct+'%';
          if(pct<100) holdRaf = requestAnimationFrame(tick);
          else doDelete(p,chip);
        };
        holdRaf = requestAnimationFrame(tick);
      };
      const endH = ()=>{
        if(holdRaf) cancelAnimationFrame(holdRaf);
        chip.classList.remove('holding'); if(bar) bar.style.width='0%';
      };
      chip.addEventListener('mousedown', startH); chip.addEventListener('touchstart', startH, {passive:false});
      chip.addEventListener('mouseup', endH); chip.addEventListener('mouseleave', endH);
      chip.addEventListener('touchend', endH); chip.addEventListener('touchcancel', endH);
    }
    presetRow.appendChild(chip);
  });
}

function doDelete(p, chip){
  chip.classList.remove('holding');
  if(confirm(`Delete preset "${p.label}"?`)){
    saveCustom(getCustom().filter(x=>x.id!==p.id));
    if(activePreset.id===p.id) activePreset=BUILTIN[0];
    renderPresets(); refreshPreview();
  }
}

btnAddPre.addEventListener('click', ()=>{
  customInputs.style.display = customInputs.style.display==='none'?'flex':'none';
  customInputs.style.flexWrap='wrap';
});
btnSavePre.addEventListener('click', ()=>{
  const w=parseFloat(D('cw').value), h=parseFloat(D('ch').value);
  if(!w||!h||w<0.5||h<0.5){ alert('Enter valid width & height (min 0.5 in)'); return; }
  const nm = D('cn').value.trim()||`${w}×${h} in`;
  const id  = 'c'+Date.now();
  const arr = getCustom(); arr.push({id,label:nm,w,h,builtin:false});
  saveCustom(arr);
  activePreset={id,label:nm,w,h,builtin:false};
  customInputs.style.display='none';
  D('cw').value=D('ch').value=D('cn').value='';
  renderPresets(); refreshPreview();
});

/* ================================================================
   QR PAYLOAD
================================================================ */
function rndCode(){ return String(Math.floor(10000000+Math.random()*90000000)); }
function mkPayload(code,d){
  const o={};
  if(d.name)  o.n=d.name; if(d.cat) o.c=d.cat;
  if(d.price>0) o.p=d.price; if(d.disc>0) o.d=d.disc;
  if(d.piece) o.pt=d.piece;
  return 'BCODE:'+code+'|'+JSON.stringify(o);
}

/* ================================================================
   PREVIEW (Screen)
================================================================ */
function refreshPreview(){
  if(!croppedQRBase64 || copies===0) return;
  const p = activePreset;
  const gap = parseFloat(lblGap.value)||0;

  // Scale down for screen if needed
  const maxW = Math.min(previewCol.parentElement.clientWidth-24, 380);
  const scale = Math.min(1.4, maxW/(p.w*PX));
  const wPx = Math.round(p.w*PX*scale);
  const hPx = Math.round(p.h*PX*scale);
  const gapPx = Math.round(gap*PX*scale);
  
  // Use 82% of height for the QR square
  const qrWrapPx = Math.round(hPx*0.82);

  previewCol.innerHTML='';
  previewCol.style.gap = gapPx+'px';

  for(let i=0; i<copies; i++){
    const div = document.createElement('div');
    div.className = 'prev-lbl';
    div.style.cssText = `width:${wPx}px;height:${hPx}px;padding:${Math.max(1,hPx*.03)}px;gap:${Math.max(2,wPx*.02)}px;`;

    // QR Area - uses the perfectly cropped Base64 image
    const qw = document.createElement('div');
    qw.className = 'qw';
    qw.style.cssText = `width:${qrWrapPx}px;height:${qrWrapPx}px;`;
    qw.innerHTML = `<img src="${croppedQRBase64}">`;

    // Text Area
    const tx = document.createElement('div');
    tx.className = 'tx';
    const fBase = Math.max(7, hPx*0.1);
    
    if(labelData.name) {
      const e = document.createElement('div'); e.className='nm'; e.style.fontSize=fBase+'px'; e.textContent=labelData.name; tx.appendChild(e);
    }
    if(labelData.disc>0) {
      const e=document.createElement('div'); e.className='dc'; e.style.fontSize=(fBase*.85)+'px'; e.textContent='Rs '+Math.round(labelData.price); tx.appendChild(e);
      const e2=document.createElement('div'); e2.className='pr'; e2.style.fontSize=(fBase*1.1)+'px'; e2.textContent='Rs '+Math.round(labelData.disc); tx.appendChild(e2);
    } else if(labelData.price>0) {
      const e=document.createElement('div'); e.className='pr'; e.style.fontSize=(fBase*1.1)+'px'; e.textContent='Rs '+Math.round(labelData.price); tx.appendChild(e);
    }
    if(labelData.piece) {
      const e=document.createElement('div'); e.className='pc'; e.style.fontSize=(fBase*.8)+'px'; e.textContent=labelData.piece; tx.appendChild(e);
    }

    div.appendChild(qw);
    div.appendChild(tx);
    previewCol.appendChild(div);
  }

  D('lbl-count').textContent = copies;
  D('size-info').textContent = `${p.label}${gap?', '+gap+'" gap':''}`;
}

/* ================================================================
   GENERATE ACTION
================================================================ */
btnGenerate.addEventListener('click', () => {
  const name  = D('b-name').value.trim();
  const cat   = D('b-category').value;
  const price = parseFloat(D('b-price').value)||0;
  const disc  = parseFloat(D('b-disc').value)||0;
  const piece = D('b-piece').value;
  const n     = Math.min(200, Math.max(1, parseInt(D('b-copies').value)||1));

  labelData = {name,cat,price,disc,piece};
  payload   = mkPayload(rndCode(), labelData);
  copies    = n;

  // Show generating state
  const origBtnHtml = btnGenerate.innerHTML;
  btnGenerate.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Generating...';
  btnGenerate.disabled = true;

  // Create perfect cropped QR once, then reuse it
  generateCroppedQR(payload, (b64) => {
    croppedQRBase64 = b64;
    btnGenerate.innerHTML = origBtnHtml;
    btnGenerate.disabled = false;
    
    printCard.style.display='';
    previewSec.style.display='';
    refreshPreview();
    printCard.scrollIntoView({behavior:'smooth', block:'start'});
  });
});
lblGap.addEventListener('input', refreshPreview);

/* ================================================================
   PRINT / PDF (Uses Hidden Iframe - fixes mobile blank page)
================================================================ */
function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function openPrintIframe() {
  if(!croppedQRBase64) return;
  const p = activePreset;
  const gap = parseFloat(lblGap.value)||0;

  // Print sizes in inches
  const w = p.w;
  const h = p.h;
  const qrSize = Math.min(h, w) * 0.84; // 84% of height
  const gapIn = gap;

  // Generate HTML for iframe
  let html = `<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Labels</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  @page { size: ${w}in ${h}in; margin: 0; }
  body { margin: 0; padding: 0; background: #fff; font-family: sans-serif; }
  .lbl {
    width: ${w}in; height: ${h}in;
    display: flex; flex-direction: row; align-items: center;
    overflow: hidden; background: #fff;
    padding: 0.05in; gap: 0.05in;
    page-break-after: always; break-after: page;
    margin-bottom: ${gapIn}in; /* Gap for PDF viewing */
  }
  .lbl:last-child { page-break-after: auto; break-after: auto; margin-bottom: 0; }
  .qw {
    flex: 0 0 auto; width: ${qrSize}in; height: ${qrSize}in;
    display: flex; align-items: center; justify-content: center;
  }
  .qw img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .tx {
    flex: 1 1 auto; display: flex; flex-direction: column;
    justify-content: center; overflow: hidden;
    padding-right: 0.02in; line-height: 1.15;
  }
  .nm { font-size: ${Math.max(7, h*10)}pt; font-weight: 700; word-break: break-word; }
  .pr { font-size: ${Math.max(9, h*12)}pt; font-weight: 900; }
  .dc { font-size: ${Math.max(6, h*8)}pt; color: #c00; text-decoration: line-through; }
  .pc { font-size: ${Math.max(5, h*7)}pt; color: #444; }
</style>
</head><body>`;

  for(let i=0; i<copies; i++) {
    html += `<div class="lbl">
      <div class="qw"><img src="${croppedQRBase64}"></div>
      <div class="tx">`;
    if(labelData.name) html += `<div class="nm">${esc(labelData.name)}</div>`;
    if(labelData.disc>0) {
      html += `<div class="dc">Rs ${Math.round(labelData.price)}</div>`;
      html += `<div class="pr">Rs ${Math.round(labelData.disc)}</div>`;
    } else if(labelData.price>0) {
      html += `<div class="pr">Rs ${Math.round(labelData.price)}</div>`;
    }
    if(labelData.piece) html += `<div class="pc">${esc(labelData.piece)}</div>`;
    html += `</div></div>`;
  }
  html += `</body></html>`;

  // Create iframe for printing
  const iframe = document.createElement('iframe');
  iframe.style.position = 'fixed';
  iframe.style.right = '0';
  iframe.style.bottom = '0';
  iframe.style.width = '0';
  iframe.style.height = '0';
  iframe.style.border = '0';
  document.body.appendChild(iframe);

  iframe.contentWindow.document.open();
  iframe.contentWindow.document.write(html);
  iframe.contentWindow.document.close();

  // Give the browser a moment to render the Base64 image
  setTimeout(() => {
    iframe.contentWindow.focus();
    iframe.contentWindow.print();
    // Cleanup
    setTimeout(() => { document.body.removeChild(iframe); }, 3000);
  }, 250);
}

btnPrint.addEventListener('click', openPrintIframe);
btnPdf.addEventListener('click', () => {
  alert('In the print dialog, select "Save as PDF" to download the file.');
  setTimeout(openPrintIframe, 300);
});

/* Enter shortcut */
['b-name','b-price','b-disc','b-copies'].forEach(id=>{
  const el=D(id);
  if(el) el.addEventListener('keydown',e=>{ if(e.key==='Enter') btnGenerate.click(); });
});

/* ── INIT ── */
renderPresets();
printCard.style.display='none';
previewSec.style.display='none';

})();
</script>
