<!-- =========================================================
     CREATE BARCODE  –  QR Label Generator
     Requires: Bootstrap 5, FontAwesome 6 (from layout)
     ========================================================= -->

<!-- JsBarcode CDN -->
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>

<style>
  /* ---- Page ---- */
  #barcode-page { max-width: 900px; margin: 0 auto; }

  /* ---- Labels grid ---- */
  #labels-area {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 14px;
    background: #f4f4f4;
    border: 1px solid #dee2e6;
    border-radius: 6px;
    min-height: 80px;
  }

  /* Each label: 38mm × 25mm (2-up thermal sticker) */
  .qr-label {
    width: 144px;      /* ~38mm on 96dpi screen */
    height: 110px;      /* slightly taller to fit barcode num */
    background: #fff;
    border: 1px solid #bbb;
    border-radius: 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 3px 2px 2px;
    box-sizing: border-box;
    page-break-inside: avoid;
    break-inside: avoid;
    overflow: hidden;
  }

  /* Name at top */
  .qr-label .label-name {
    font-size: 9px;
    font-weight: bold;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 98%;
    color: #000;
    line-height: 1.2;
  }

  /* Canvas barcode fills the center */
  .qr-label .label-barcode-canvas {
    max-width: 100%;
    height: 45px !important;
    display: block;
    image-rendering: pixelated;
  }

  /* Numeric code below barcode */
  .qr-label .label-barcode-num {
    font-size: 8px;
    font-family: 'Courier New', monospace;
    letter-spacing: 2px;
    color: #000;
    text-align: center;
    margin-top: 0;
    line-height: 1;
  }

  /* Price line at bottom */
  .qr-label .price-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-size: 9px;
    color: #000;
    line-height: 1;
  }
  .qr-label .label-price { font-weight: 900; font-size: 10px; }
  .qr-label .label-disc  { text-decoration: line-through; font-size: 8px; color: #c00; }
  .qr-label .label-piece { font-size: 8px; color: #333; }

  /* Empty placeholder */
  #labels-placeholder {
    width: 100%;
    text-align: center;
    color: #aaa;
    font-size: .9rem;
    padding: 20px;
  }

  /* ---- PRINT STYLES ---- */
  @media print {
    body * { visibility: hidden !important; }
    
    @page { margin: 0; }

    #labels-area, #labels-area * { visibility: visible !important; }
    #labels-area {
      position: fixed !important;
      top: 0; left: 0;
      width: 80mm !important;
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      gap: 0 !important;
      margin: 0 !important;
      display: flex !important;
      flex-wrap: wrap !important;
    }

    .qr-label {
      width: 38mm !important;
      height: 25mm !important;
      border: none !important;
      padding: 0.5mm 1mm !important;
      margin: 0 !important;
      float: left !important;
      border-radius: 0 !important;
    }

    .qr-label .label-barcode-canvas { 
      max-width: 100% !important; 
      height: 14mm !important; 
      width: auto !important;
    }
    .qr-label .label-barcode-num { font-size: 5pt !important; letter-spacing: 1px !important; }
    .qr-label .label-name  { font-size: 6pt !important; }
    .qr-label .price-line { font-size: 6pt !important; }
    .qr-label .label-price { font-size: 7pt !important; }
    .qr-label .label-disc  { font-size: 5pt !important; }
    .qr-label .label-piece { font-size: 5pt !important; }
  }
</style>

<div id="barcode-page" class="container-fluid py-3">

  <!-- Header -->
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="mb-0 fw-bold">
      <i class="fa-solid fa-qrcode me-2 text-primary"></i>Create Barcode / QR Labels
    </h4>
  </div>

  <!-- ===== FORM ===== -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white py-2">
      <i class="fa-solid fa-sliders me-2"></i>Label Details
    </div>
    <div class="card-body">
      <div class="row g-3 align-items-end">

        <!-- Item Name -->
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label fw-semibold small" for="b-name">Item Name</label>
          <input type="text" class="form-control" id="b-name" placeholder="e.g. Zellbury Shirt">
        </div>

        <!-- Category -->
        <div class="col-12 col-sm-6 col-md-2">
          <label class="form-label fw-semibold small" for="b-category">Category</label>
          <select class="form-select" id="b-category">
            <option value="">-- Select --</option>
            <% if (typeof allCategories !== 'undefined' && allCategories.length) { %>
              <% allCategories.forEach(function(cat){ %>
                <option value="<%= cat.categoryName %>"><%= cat.categoryName %></option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Price -->
        <div class="col-6 col-sm-4 col-md-2">
          <label class="form-label fw-semibold small" for="b-price">Price</label>
          <input type="number" class="form-control" id="b-price" placeholder="0" min="0" step="0.01">
        </div>

        <!-- Discounted Price -->
        <div class="col-6 col-sm-4 col-md-2">
          <label class="form-label fw-semibold small" for="b-disc">Discounted Price</label>
          <input type="number" class="form-control" id="b-disc" placeholder="0" min="0" step="0.01">
        </div>

        <!-- Piece Type -->
        <div class="col-6 col-sm-4 col-md-1">
          <label class="form-label fw-semibold small" for="b-piece">Piece</label>
          <select class="form-select" id="b-piece">
            <option value="">--</option>
            <% ['1pc','2pc','3pc','4pc','5pc','6pc','7pc','8pc','9pc','10pc'].forEach(function(p){ %>
              <option value="<%= p %>"><%= p %></option>
            <% }); %>
          </select>
        </div>

        <!-- Copies -->
        <div class="col-6 col-sm-4 col-md-1">
          <label class="form-label fw-semibold small" for="b-copies">Copies</label>
          <input type="number" class="form-control" id="b-copies" value="1" min="1" max="100">
        </div>

        <!-- Generate Button -->
        <div class="col-12 col-md-1 d-flex align-items-end">
          <button class="btn btn-primary w-100" id="btn-generate" type="button">
            <i class="fa-solid fa-qrcode me-1"></i>Generate
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- ===== LABELS OUTPUT ===== -->
  <div class="d-flex align-items-center justify-content-between mb-2">
    <h6 class="mb-0 fw-bold text-secondary">
      <i class="fa-solid fa-tags me-1"></i>Generated Labels
      <span class="badge bg-secondary ms-1" id="label-count">0</span>
    </h6>
    <button class="btn btn-success btn-sm" id="btn-print-labels" style="display:none;" type="button">
      <i class="fa-solid fa-print me-1"></i>Print Labels
    </button>
  </div>

  <div id="labels-area">
    <div id="labels-placeholder">
      <i class="fa-solid fa-qrcode fa-2x mb-2 d-block text-muted"></i>
      Generated labels will appear here
    </div>
  </div>

</div><!-- /barcode-page -->

<!-- ===== PAGE SCRIPT ===== -->
<script>
(function () {
  'use strict';

  const btnGenerate   = document.getElementById('btn-generate');
  const btnPrint      = document.getElementById('btn-print-labels');
  const labelsArea    = document.getElementById('labels-area');
  const labelCount    = document.getElementById('label-count');
  const placeholder   = document.getElementById('labels-placeholder');

  /* ------------------------------------------------------------------ */
  /*  GENERATE RANDOM 8-DIGIT BARCODE NUMBER                            */
  /* ------------------------------------------------------------------ */
  function genBarcodeNum() {
    // Random 8-digit number: 10000000 – 99999999
    return String(Math.floor(10000000 + Math.random() * 90000000));
  }

  /* ------------------------------------------------------------------ */
  /*  BUILD SCAN PAYLOAD                                                 */
  /*  Format: BCODE:<8digitNum>|<json>                                   */
  /*  This keeps the barcode value short (scannable) while still         */
  /*  carrying product data for the POS scanner.                         */
  /* ------------------------------------------------------------------ */
  function buildScanPayload(barcodeNum, name, category, price, discountedPrice, pieceType) {
    const obj = {};
    if (name)               obj.n  = name;
    if (category)           obj.c  = category;
    if (price > 0)          obj.p  = price;
    if (discountedPrice > 0) obj.d = discountedPrice;
    if (pieceType)          obj.pt = pieceType;
    // Prefix with barcode number so scanner can extract both
    return 'BCODE:' + barcodeNum + '|' + JSON.stringify(obj);
  }

  /* ------------------------------------------------------------------ */
  /*  CREATE SINGLE LABEL ELEMENT                                        */
  /* ------------------------------------------------------------------ */
  function createLabel(scanPayload, barcodeNum, name, price, discountedPrice, pieceType) {
    const label = document.createElement('div');
    label.className = 'qr-label';

    // --- TOP: Name ---
    if (name) {
      const nameEl = document.createElement('div');
      nameEl.className = 'label-name';
      nameEl.textContent = name;
      label.appendChild(nameEl);
    }

    // --- MIDDLE: Canvas Barcode ---
    const canvasEl = document.createElement('canvas');
    canvasEl.className = 'label-barcode-canvas';
    label.appendChild(canvasEl);

    // --- BARCODE NUMBER (shown below bars) ---
    const codeNumEl = document.createElement('div');
    codeNumEl.className = 'label-barcode-num';
    codeNumEl.textContent = barcodeNum;
    label.appendChild(codeNumEl);

    // --- BOTTOM: Price ---
    const priceLine = document.createElement('div');
    priceLine.className = 'price-line';

    if (discountedPrice > 0) {
      const oldPriceEl = document.createElement('span');
      oldPriceEl.className = 'label-disc';
      oldPriceEl.textContent = 'Rs ' + parseFloat(price).toFixed(0);
      const newPriceEl = document.createElement('span');
      newPriceEl.className = 'label-price';
      newPriceEl.textContent = ' Rs ' + parseFloat(discountedPrice).toFixed(0);
      priceLine.appendChild(oldPriceEl);
      priceLine.appendChild(newPriceEl);
    } else if (price > 0) {
      const priceEl = document.createElement('span');
      priceEl.className = 'label-price';
      priceEl.textContent = 'Rs ' + parseFloat(price).toFixed(0);
      priceLine.appendChild(priceEl);
    }

    if (pieceType) {
      const pieceEl = document.createElement('span');
      pieceEl.className = 'label-piece';
      pieceEl.textContent = '  ' + pieceType;
      priceLine.appendChild(pieceEl);
    }

    if (priceLine.childNodes.length > 0) {
      label.appendChild(priceLine);
    }

    // Generate barcode on canvas after a tick
    setTimeout(function () {
      try {
        JsBarcode(canvasEl, scanPayload, {
          format: "CODE128",
          renderer: "canvas",
          displayValue: false,
          margin: 2,
          width: 1.4,
          height: 50,
          background: "#ffffff",
          lineColor: "#000000"
        });
      } catch (e) {
        canvasEl.outerHTML = '<span style="font-size:9px;color:red;">Barcode Error</span>';
        console.error('Barcode error:', e);
      }
    }, 0);

    return label;
  }

  /* ------------------------------------------------------------------ */
  /*  GENERATE BUTTON                                                    */
  /* ------------------------------------------------------------------ */
  btnGenerate.addEventListener('click', function () {
    const name           = document.getElementById('b-name').value.trim();
    const category       = document.getElementById('b-category').value;
    const price          = parseFloat(document.getElementById('b-price').value) || 0;
    const discountedPrice= parseFloat(document.getElementById('b-disc').value)  || 0;
    const pieceType      = document.getElementById('b-piece').value;
    const copies         = Math.min(100, Math.max(1, parseInt(document.getElementById('b-copies').value) || 1));

    // Clear previous
    labelsArea.innerHTML = '';
    placeholder.style.display = 'none';

    // Generate ONE barcode number for this batch (same number on all copies)
    const barcodeNum   = genBarcodeNum();
    const scanPayload  = buildScanPayload(barcodeNum, name, category, price, discountedPrice, pieceType);

    for (let i = 0; i < copies; i++) {
      labelsArea.appendChild(
        createLabel(scanPayload, barcodeNum, name, price, discountedPrice, pieceType)
      );
    }

    labelCount.textContent = copies;
    btnPrint.style.display = copies > 0 ? 'inline-block' : 'none';

    // Scroll to labels
    labelsArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* ------------------------------------------------------------------ */
  /*  PRINT BUTTON                                                       */
  /* ------------------------------------------------------------------ */
  btnPrint.addEventListener('click', function () {
    window.print();
  });

  /* ------------------------------------------------------------------ */
  /*  Allow pressing Enter in form to trigger generate                   */
  /* ------------------------------------------------------------------ */
  ['b-name','b-price','b-disc','b-copies'].forEach(function (id) {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnGenerate.click();
      });
    }
  });

})();
</script>
