      custBlock.style.display = 'block';
      document.getElementById('slip-cust-name').textContent  = custName  ? 'Customer: ' + custName  : '';
      document.getElementById('slip-cust-phone').textContent = custPhone ? 'Phone: '    + custPhone : '';
      document.getElementById('slip-cust-city').textContent  = custCity  ? 'City: '     + custCity  : '';
    } else { custBlock.style.display = 'none'; }
    const discRow = document.getElementById('slip-disc-row');
    if (custDiscTotal > 0) { discRow.style.display = ''; document.getElementById('slip-disc-total').textContent = 'Rs ' + fmt(custDiscTotal); }
    else { discRow.style.display = 'none'; }
    document.getElementById('slip-payment-method').textContent = paymentMethod;
    const amountPaid = parseFloat(document.getElementById('cust-amount-paid').value) || 0;
    const baseForBalance = custDiscTotal > 0 ? custDiscTotal : finalGrand;
    const remaining = baseForBalance - amountPaid;
    const paidRow = document.getElementById('slip-paid-row');
    const remRow  = document.getElementById('slip-remaining-row');
    const isFullUdhaar = (paymentMethod === 'Remaining (Udhaar)' && amountPaid === 0);
    if (amountPaid > 0 || isFullUdhaar) { paidRow.style.display = ''; document.getElementById('slip-amount-paid').textContent = 'Rs ' + fmt(amountPaid); }
    else { paidRow.style.display = 'none'; }
    if ((amountPaid > 0 && remaining > 0) || isFullUdhaar) { remRow.style.display = ''; document.getElementById('slip-remaining').textContent = 'Rs ' + fmt(isFullUdhaar ? baseForBalance : remaining); }
    else { remRow.style.display = 'none'; }
    callback();
  }

  function captureSlip(onCanvas) {
    const slip = document.getElementById('print-slip');
    const targetMm = (selectedSize === '4inch') ? 104 : 80;

    // Apply exact size class and render offscreen
    slip.className = 'print-' + selectedSize;
    slip.style.display    = 'block';
    slip.style.position   = 'fixed';
    slip.style.left       = '0px';
    slip.style.top        = '0px';
    slip.style.zIndex     = '-999';
    slip.style.width      = targetMm + 'mm';
    slip.style.maxWidth   = targetMm + 'mm';
    slip.style.background = '#ffffff';

    setTimeout(function () {
      html2canvas(slip, {
        scale: 3,
        useCORS: true,
        allowTaint: true,
        backgroundColor: '#ffffff',
        logging: false,
        width:        slip.offsetWidth,
        height:       slip.offsetHeight,
        windowWidth:  slip.offsetWidth,
        windowHeight: slip.offsetHeight
      }).then(function(canvas) {
        slip.style.display    = 'none';
        slip.style.position   = '';
        slip.style.left       = '';
        slip.style.top        = '';
        slip.style.zIndex     = '';
        slip.style.width      = '';
        slip.style.maxWidth   = '';
        slip.className        = '';
        onCanvas(canvas, targetMm);
      }).catch(function(err) {
        slip.style.display    = 'none';
        slip.style.position   = '';
        slip.style.left       = '';
        slip.style.top        = '';
        slip.style.zIndex     = '';
        slip.style.width      = '';
        slip.style.maxWidth   = '';
        slip.className        = '';
        toastr.error('Export failed: ' + err);
      });
    }, 120);
  }

  document.getElementById('btn-download-img').addEventListener('click', function () {
    buildSlipForExport(function() {
      captureSlip(function(canvas, targetMm) {
        const link = document.createElement('a');
        link.download = 'bill_' + selectedSize + '_' + Date.now() + '.png';
        link.href = canvas.toDataURL('image/png', 1.0);
        link.click();
      });
    });
  });

  document.getElementById('btn-download-pdf').addEventListener('click', function () {
    buildSlipForExport(function() {
      captureSlip(function(canvas, targetMm) {
        const { jsPDF } = window.jspdf;
        const pdfW = targetMm;
        const pdfH = (canvas.height / canvas.width) * targetMm;
        const pdf = new jsPDF({
          orientation: 'portrait',
          unit: 'mm',
          format: [pdfW, pdfH]
        });
        pdf.addImage(canvas.toDataURL('image/png', 1.0), 'PNG', 0, 0, pdfW, pdfH);
        pdf.save('bill_' + selectedSize + '_' + Date.now() + '.pdf');
      });
    });
  });

  /* ------------------------------------------------------------------ */
  /*  CAMERA / QR SCANNER                                                 */
  /* ------------------------------------------------------------------ */
  function showFlash() {
    const flash = document.getElementById('scan-flash');
    flash.classList.add('show');
    setTimeout(function () { flash.classList.remove('show'); }, 280);
  }

  function setScanStatus(msg, color) {
    const el = document.getElementById('scan-status');
    el.textContent = msg;
    el.style.color = color || '#fff';
  }

  function onScanSuccess(decodedText) {
    const now_ms = Date.now();
    // Debounce: skip if same code within 1500ms
    if (decodedText === lastScannedCode && now_ms - lastScanTime < 1500) return;
    lastScannedCode = decodedText;
    lastScanTime = now_ms;

    let data = {};
    let barcodeNum = '';

    // Parse BCODE:<num>|<json> format from createBarcode page
    if (decodedText.startsWith('BCODE:')) {
      const pipeIdx = decodedText.indexOf('|');
      if (pipeIdx > 6) {
        barcodeNum = decodedText.substring(6, pipeIdx);
        try { data = JSON.parse(decodedText.substring(pipeIdx + 1)); } catch(e) { data = {}; }
      } else {
        barcodeNum = decodedText.substring(6);
      }
    } else {
      // Legacy plain-JSON or raw text
      try { data = JSON.parse(decodedText); } catch (e) { data = { n: decodedText }; }
    }

    // Auto-add with qty 1, keep scanner open
    const itemName  = data.name || data.n || barcodeNum || '';
    const itemCat   = data.category || data.c || '';
    const itemPrice = parseFloat(data.price || data.p) || 0;
    const itemDisc  = parseFloat(data.discountedPrice || data.d) || 0;
    const itemPiece = data.pieceType || data.pt || '';

    addItem({
      name:            itemName,
      category:        itemCat,
      price:           itemPrice,
      discountedPrice: itemDisc,
      pieceType:       itemPiece,
      qty: 1,
    });

    showFlash();
    setScanStatus('✔ Added: ' + (itemName || barcodeNum || 'item'), '#6aff9b');
    setTimeout(function () { setScanStatus('Point camera at barcode…'); }, 1800);
  }

  function onScanFailure() { /* silent */ }

  function openScanner() {
    if (scannerRunning) return;
    document.getElementById('camera-overlay').classList.add('active');
    setScanStatus('Starting camera…');

    html5QrCode = new Html5Qrcode('qr-reader');
    const config = {
      fps: 15,
      qrbox: { width: 260, height: 260 },
      aspectRatio: 1.0,
    };
    html5QrCode.start(
      { facingMode: 'environment' },
      config,
      onScanSuccess,
      onScanFailure
    ).then(function () {
      scannerRunning = true;
      setScanStatus('Point camera at a QR code…');
    }).catch(function (err) {
      setScanStatus('Camera error: ' + err, '#ff6b6b');
      console.error('QR scanner start error:', err);
    });
  }

  function stopScanner() {
    if (!scannerRunning || !html5QrCode) return;
    html5QrCode.stop().then(function () {
      html5QrCode = null;
      scannerRunning = false;
      document.getElementById('camera-overlay').classList.remove('active');
    }).catch(function (err) {
      console.error('QR scanner stop error:', err);
      document.getElementById('camera-overlay').classList.remove('active');
    });
  }

  document.getElementById('btn-open-scan').addEventListener('click', openScanner);
  document.getElementById('btn-stop-scan').addEventListener('click', stopScanner);

  // ---- Return Scanner ----
  let returnScannerRunning = false;
  let returnHtml5QrCode    = null;
  let lastReturnScannedCode = '';
  let lastReturnScanTime    = 0;

  function openReturnScanner() {
    if (returnScannerRunning) return;
    document.getElementById('return-camera-overlay').style.display = 'flex';
    const rStatus = document.getElementById('return-scan-status');
    rStatus.textContent = 'Starting camera…'; rStatus.style.color = '#fff';
    returnHtml5QrCode = new Html5Qrcode('return-qr-reader');
    returnHtml5QrCode.start(
      { facingMode: 'environment' },
      { fps: 15, qrbox: { width: 260, height: 260 }, aspectRatio: 1.0 },
      function(decodedText) {
        const now_ms = Date.now();
        if (decodedText === lastReturnScannedCode && now_ms - lastReturnScanTime < 1500) return;
        lastReturnScannedCode = decodedText; lastReturnScanTime = now_ms;
        let data = {}, barcodeNum = '';
        if (decodedText.startsWith('BCODE:')) {
          const pipeIdx = decodedText.indexOf('|');
          if (pipeIdx > 6) { barcodeNum = decodedText.substring(6, pipeIdx); try { data = JSON.parse(decodedText.substring(pipeIdx + 1)); } catch(e) { data = {}; } }
          else { barcodeNum = decodedText.substring(6); }
        } else { try { data = JSON.parse(decodedText); } catch (e) { data = { n: decodedText }; } }
        const scannedName  = data.name || data.n || barcodeNum || '';
        const scannedCat   = data.category || data.cat || data.c || '';
        const scannedPrice = parseFloat(data.price || data.p) || 0;
        const scannedDisc  = parseFloat(data.discountedPrice || data.disc || data.d) || 0;
        // If disc price is added (> 0), soldFor defaults to disc price; otherwise regular price!
        const defaultSold  = scannedDisc > 0 ? scannedDisc : scannedPrice;
        const scannedSold  = parseFloat(data.soldFor || data.sf) || defaultSold;
        const scannedPiece = data.pieceType || data.piece || data.pt || '';
        const scannedQty   = parseInt(data.quantity || data.qty || data.q) || 1;

        addReturnItem({
          name:            scannedName,
          category:        scannedCat,
          price:           scannedPrice,
          discountedPrice: scannedDisc,
          soldFor:         scannedSold,
          pieceType:       scannedPiece,
          qty:             scannedQty
        });
        showFlash();
        rStatus.innerHTML = '&#8617; Return added: ' + (data.name||data.n||barcodeNum||'item');
        rStatus.style.color = '#ffc107';
        setTimeout(function() { rStatus.textContent = 'Point camera at barcode…'; rStatus.style.color = '#fff'; }, 1800);
      },
      function() {}
    ).then(function() { returnScannerRunning = true; rStatus.textContent = 'Point camera at barcode…'; })
     .catch(function(err) { rStatus.textContent = 'Camera error: ' + err; rStatus.style.color = '#ff6b6b'; });
  }

  function stopReturnScanner() {
    if (!returnScannerRunning || !returnHtml5QrCode) return;
    returnHtml5QrCode.stop().then(function() {
      returnHtml5QrCode = null; returnScannerRunning = false;
      document.getElementById('return-camera-overlay').style.display = 'none';
    }).catch(function(err) { console.error(err); document.getElementById('return-camera-overlay').style.display = 'none'; });
  }

  document.getElementById('btn-open-return-scan').addEventListener('click', openReturnScanner);
  document.getElementById('btn-stop-return-scan').addEventListener('click', stopReturnScanner);


  // Keep remaining balance in sync when discount total changes
  document.getElementById('cust-discount-total').addEventListener('input', calcRemainingBalance);

  // Initial render
  renderTable();

})();
</script>
