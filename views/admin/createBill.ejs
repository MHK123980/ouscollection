  </button>
</div>

<!-- ===== PRINT SLIP (hidden until print) ===== -->
<div id="print-slip" style="display:none;">
  <div class="slip-header">
    <img src="/img/ous-logo.png" class="slip-logo" alt="Logo" style="max-width: 90px; margin-bottom: 5px;">
    <div style="font-size: 9pt; font-weight: bold; margin-bottom: 4px;">0324 3503152</div>
    <div class="slip-subtitle">LADIES &amp; GENTS FASHION</div>
    <div class="slip-subtitle">WHOLESALE &amp; RETAIL</div>
    <div class="slip-datetime" id="slip-datetime"></div>
  </div>

  <!-- Customer info (shown only if filled) -->
  <div id="slip-cust-block" style="display:none; border-bottom:1px dashed #000; padding-bottom:6px; margin-bottom:6px; font-size:8pt;">
    <div id="slip-cust-name"></div>
    <div id="slip-cust-phone"></div>
    <div id="slip-cust-city"></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Item</th>
        <th>Cat</th>
        <th>Pc</th>
        <th class="text-center">Qty</th>
        <th class="text-right">Price</th>
        <th class="text-right">Disc</th>
        <th class="text-right">Total</th>
      </tr>
    </thead>
    <tbody id="slip-tbody"></tbody>
    <tfoot>
      <tr>
        <td colspan="8" style="text-align:right; font-weight:bold; padding:8px 3px 6px;">
          Grand Total:&nbsp;&nbsp;<span class="slip-grand" id="slip-grand" style="font-size:13pt; font-weight:900;"></span>
        </td>
      </tr>
      <!-- Discounted total row: shown only if entered -->
      <tr id="slip-disc-row" style="display:none;">
        <td colspan="8" style="text-align:right; font-weight:900; font-size:11pt; color:#c00; padding:4px 3px;">
          Amount to Pay:&nbsp;&nbsp;<span id="slip-disc-total" style="font-size:12pt; font-weight:900;"></span>
        </td>
      </tr>
      <!-- Payment Method row -->
      <tr id="slip-payment-row">
        <td colspan="8" style="text-align:center; font-weight:bold; font-size:9pt; padding:6px 3px 4px; border-top:1px dashed #222;">
          Payment Method: <span id="slip-payment-method"></span>
        </td>
      </tr>
      <!-- Amount Paid row: shown only if entered -->
      <tr id="slip-paid-row" style="display:none;">
        <td colspan="8" style="text-align:center; font-weight:bold; font-size:9pt; color:#007700; padding:3px;">
          Amount Received: <span id="slip-amount-paid"></span>
        </td>
      </tr>
      <!-- Remaining Balance row: shown only if > 0 -->
      <tr id="slip-remaining-row" style="display:none;">
        <td colspan="8" style="text-align:center; font-weight:900; font-size:9.5pt; color:#c00; padding:3px;">
          Outstanding Balance: <span id="slip-remaining"></span>
        </td>
      </tr>
    </tfoot>
  </table>
  <div class="slip-footer">
    <div class="slip-footer-thanks">Thanks For Choosing OUS Collection</div>
    <div style="font-weight: bold; margin-bottom: 6px; font-size: 9pt;">Please Shop Again!</div>
    <div>Powered By MHT Devs</div>
  </div>
</div>

<!-- ===== PAGE SCRIPT ===== -->
<script>
// Global: called from oninput attribute on Amount Paid field
function calcRemainingBalance() {
  let grand = 0;
  document.querySelectorAll('.row-line-total').forEach(function(cell) {
    const val = cell.textContent.replace(/[^0-9.]/g,'');
    grand += parseFloat(val) || 0;
  });
  let returnTotal = 0;
  document.querySelectorAll('.row-return-total').forEach(function(cell) {
    const val = cell.textContent.replace(/[^0-9.]/g,'');
    returnTotal += parseFloat(val) || 0;
  });
  const netGrand = Math.max(0, grand - returnTotal);
  const discTotal = parseFloat(document.getElementById('cust-discount-total').value) || 0;
  const baseAmt   = discTotal > 0 ? discTotal : netGrand;
  const paid      = parseFloat(document.getElementById('cust-amount-paid').value) || 0;
  const rem       = Math.max(0, baseAmt - paid);
  document.getElementById('cust-remaining').value = paid > 0 ? rem.toFixed(2) : '';
}

(function () {
  'use strict';

  /* ------------------------------------------------------------------ */
  /*  STATE                                                               */
  /* ------------------------------------------------------------------ */
  let billItems = [];
  let returnItems = [];
  let selectedSize = '3inch';
  let html5QrCode = null;
  let scannerRunning = false;
  let lastScannedCode = '';   // debounce same code scanned twice
  let lastScanTime = 0;

  /* ------------------------------------------------------------------ */
  /*  HELPERS                                                             */
  /* ------------------------------------------------------------------ */
  const fmt = v => parseFloat(v || 0).toFixed(2);

  function lineTotal(item) {
    const unitPrice = item.discountedPrice > 0 ? item.discountedPrice : item.price;
    return unitPrice * item.qty;
  }

  function now() {
    return new Date().toLocaleString('en-PK', {
      dateStyle: 'medium', timeStyle: 'short'
    });
  }

  /* ------------------------------------------------------------------ */
  /*  RENDER BILL TABLE                                                   */
  /* ------------------------------------------------------------------ */
  function renderTable() {
    const tbody = document.getElementById('items-tbody');
    tbody.innerHTML = '';

    const hasItems   = billItems.length > 0;
    const hasReturns = returnItems.length > 0;

    if (!hasItems && !hasReturns) {
      tbody.innerHTML = `<tr id="empty-row">
        <td colspan="10" class="text-center text-muted py-3">
          <i class="fa-solid fa-cart-plus me-2"></i>No items added yet
        </td></tr>`;
      updateGrandTotal();
      return;
    }

    // -- Normal bill items --
    billItems.forEach(function (item, idx) {
      const lt = lineTotal(item);
      const tr = document.createElement('tr');
      tr.className = 'bill-item-row';
      tr.innerHTML = `
        <td>${idx + 1}</td>
        <td>${escHtml(item.name)}</td>
        <td>${escHtml(item.category)}</td>
        <td>${escHtml(item.pieceType || '—')}</td>
        <td>
          <input type="number" class="form-control form-control-sm row-qty"
                 data-idx="${idx}" data-type="bill"
                 value="${item.qty}" min="1" step="1"
                 style="width:50px;padding:2px 4px;font-size:12px;height:26px;">
        </td>
        <td>Rs ${fmt(item.price)}</td>
        <td>
          <input type="number" class="form-control form-control-sm row-disc-price"
                 data-idx="${idx}" data-type="bill"
                 value="${item.discountedPrice > 0 ? item.discountedPrice : ''}"
                 placeholder="0.00" min="0" step="0.01"
                 style="width:75px;padding:2px 4px;font-size:12px;height:26px;">
        </td>
        <td><span class="text-muted">—</span></td>
        <td class="row-line-total">Rs ${fmt(lt)}</td>
        <td>
          <button class="btn btn-danger btn-sm btn-remove" data-idx="${idx}" data-type="bill">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </td>`;
      tbody.appendChild(tr);
    });

    // -- Returned items divider --
    if (hasReturns) {
      const divRow = document.createElement('tr');
      divRow.innerHTML = `<td colspan="10" class="py-1 px-2" style="background:#212529;color:#fff;border-top:2px solid #000;">
        <i class="fa-solid fa-rotate-left me-2 text-warning"></i>
        <strong>Returned Items</strong>
        <small class="text-warning ms-2">(Sold For is deducted from total)</small>
      </td>`;
      tbody.appendChild(divRow);

      returnItems.forEach(function (item, idx) {
        const defaultVal = item.discountedPrice > 0 ? item.discountedPrice : item.price;
        const soldVal = item.soldFor > 0 ? item.soldFor : defaultVal;
        const lt = soldVal * item.qty;
        const tr = document.createElement('tr');
        tr.style.background = '#fffdf0';
        tr.className = 'return-item-row';
        tr.innerHTML = `
          <td><span class="badge bg-warning text-dark">R${idx + 1}</span></td>
          <td>${escHtml(item.name)}</td>
          <td>${escHtml(item.category)}</td>
          <td>${escHtml(item.pieceType || '—')}</td>
          <td>
            <input type="number" class="form-control form-control-sm row-qty"
                   data-idx="${idx}" data-type="return"
                   value="${item.qty}" min="1" step="1"
                   style="width:50px;padding:2px 4px;font-size:12px;height:26px;">
          </td>
          <td>Rs ${fmt(item.price)}</td>
          <td>
            <input type="number" class="form-control form-control-sm row-return-disc"
                   data-idx="${idx}"
                   value="${item.discountedPrice > 0 ? item.discountedPrice : ''}"
                   placeholder="0.00" min="0" step="0.01"
                   style="width:75px;padding:2px 4px;font-size:12px;height:26px;">
          </td>
          <td>
            <input type="number" class="form-control form-control-sm row-sold-for"
                   data-idx="${idx}"
                   value="${item.soldFor > 0 ? item.soldFor : (defaultVal > 0 ? defaultVal : '')}"
                   placeholder="Sold For" min="0" step="0.01"
                   style="width:80px;padding:2px 4px;font-size:12px;height:26px;background:#fffdf0;font-weight:bold;border:1px solid #ffc107;">
          </td>
          <td class="row-return-total text-danger fw-bold">- Rs ${fmt(lt)}</td>
          <td>
            <button class="btn btn-danger btn-sm btn-remove" data-idx="${idx}" data-type="return">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </td>`;
        tbody.appendChild(tr);
      });
    }

    updateGrandTotal();
  }

  function updateGrandTotal() {
    const billTotal   = billItems.reduce((s, i) => s + lineTotal(i), 0);
    const returnTotal = returnItems.reduce((s, i) => {
      const defaultVal = i.discountedPrice > 0 ? i.discountedPrice : i.price;
      const sf = i.soldFor > 0 ? i.soldFor : defaultVal;
      return s + (sf * i.qty);
    }, 0);
    const grand = Math.max(0, billTotal - returnTotal);
    document.getElementById('grand-total-badge').textContent = 'Total: Rs ' + fmt(grand);
    if (document.getElementById('cust-amount-paid').value) {
      calcRemainingBalance();
    }
  }

  function escHtml(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  /* ------------------------------------------------------------------ */
  /*  READ FORM                                                           */
  /* ------------------------------------------------------------------ */
  function readForm() {
    return {
      name:           document.getElementById('f-name').value.trim(),
      category:       document.getElementById('f-category').value,
      price:          parseFloat(document.getElementById('f-price').value) || 0,
      discountedPrice:parseFloat(document.getElementById('f-disc').value)  || 0,
      pieceType:      document.getElementById('f-piece').value,
      qty:            parseInt(document.getElementById('f-qty').value)    || 1,
    };
  }

  function clearForm() {
    document.getElementById('f-name').value     = '';
    document.getElementById('f-category').value = '';
    document.getElementById('f-price').value    = '';
    document.getElementById('f-disc').value     = '';
    document.getElementById('f-piece').value    = '';
    document.getElementById('f-qty').value      = 1;
  }

  
  // ---- Return Item helpers ----
  function readReturnForm() {
    const p = parseFloat(document.getElementById('r-price').value) || 0;
    const d = parseFloat(document.getElementById('r-disc').value) || 0;
    const sfInp = document.getElementById('r-sold-for').value.trim();
    // If disc price is added (> 0), default soldFor to disc price; otherwise default to price!
    const defaultSold = d > 0 ? d : p;
    const sf = sfInp !== '' ? (parseFloat(sfInp) || 0) : defaultSold;
    return {
      name:            document.getElementById('r-name').value.trim(),
      category:        document.getElementById('r-category').value,
      price:           p,
      discountedPrice: d,
      soldFor:         sf,
      pieceType:       document.getElementById('r-piece').value,
      qty:             parseInt(document.getElementById('r-qty').value) || 1,
    };
  }
  function clearReturnForm() {
    document.getElementById('r-name').value     = '';
    document.getElementById('r-category').value = '';
    document.getElementById('r-price').value    = '';
    document.getElementById('r-disc').value     = '';
    document.getElementById('r-sold-for').value = '';
    document.getElementById('r-piece').value    = '';
    document.getElementById('r-qty').value      = 1;
  }
  function addReturnItem(itemData) {
    returnItems.push(itemData);
    renderTable();
    const w = document.getElementById('items-wrapper');
    w.scrollTop = w.scrollHeight;
  }

  document.getElementById('btn-add-return').addEventListener('click', function () {
    const item = readReturnForm();
    if (!item.name) {
      toastr.warning('Please enter a return item name.');
      document.getElementById('r-name').focus();
      return;
    }
    if (!item.price || item.price <= 0) {
      toastr.warning('Please enter a valid price for the return item.');
      document.getElementById('r-price').focus();
      return;
    }
    addReturnItem(item);
    clearReturnForm();
    document.getElementById('r-name').focus();
  });

  // Live auto-calculation in Return Manual Entry form:
  function syncReturnFormSoldFor() {
    const priceVal = parseFloat(document.getElementById('r-price').value) || 0;
    const discVal  = parseFloat(document.getElementById('r-disc').value) || 0;
    const soldInp  = document.getElementById('r-sold-for');
    
    // If disc price is entered (> 0), sold for becomes disc price
    // If disc price is 0 or empty, sold for becomes regular price
    if (discVal > 0) {
      soldInp.value = discVal;
    } else if (priceVal > 0) {
      soldInp.value = priceVal;
    } else {
      soldInp.value = '';
    }
  }

  document.getElementById('r-price').addEventListener('input', syncReturnFormSoldFor);
  document.getElementById('r-disc').addEventListener('input', syncReturnFormSoldFor);

  document.getElementById('r-qty-dec').addEventListener('click', function () {
    const inp = document.getElementById('r-qty');
    inp.value = Math.max(1, (parseInt(inp.value) || 1) - 1);
  });
  document.getElementById('r-qty-inc').addEventListener('click', function () {
    const inp = document.getElementById('r-qty');
    inp.value = (parseInt(inp.value) || 1) + 1;
  });

  function fillForm(data) {
    if (data.name)           document.getElementById('f-name').value          = data.name;
    if (data.category)       document.getElementById('f-category').value      = data.category;
    if (data.price)          document.getElementById('f-price').value         = data.price;
    if (data.discountedPrice)document.getElementById('f-disc').value          = data.discountedPrice;
    if (data.pieceType)      document.getElementById('f-piece').value         = data.pieceType;
  }

  /* ------------------------------------------------------------------ */
  /*  ADD ITEM                                                            */
  /* ------------------------------------------------------------------ */
  function addItem(itemData) {
    billItems.push(itemData);
    renderTable();
    // scroll list to bottom
    const w = document.getElementById('items-wrapper');
    w.scrollTop = w.scrollHeight;
  }

  document.getElementById('btn-add-item').addEventListener('click', function () {
    const item = readForm();
    if (!item.name) {
      toastr.warning('Please enter an item name.');
      document.getElementById('f-name').focus();
      return;
    }
    addItem(item);
    clearForm();
    document.getElementById('f-name').focus();
  });

  /* ------------------------------------------------------------------ */
  /*  REMOVE ITEM (event delegation)                                      */
  /* ------------------------------------------------------------------ */
  document.getElementById('items-tbody').addEventListener('click', function (e) {
    const btn = e.target.closest('.btn-remove');
    if (!btn) return;
    const idx  = parseInt(btn.dataset.idx);
    const type = btn.dataset.type;
    if (type === 'return') {
      returnItems.splice(idx, 1);
    } else {
      billItems.splice(idx, 1);
    }
    renderTable();
  });

  /* ------------------------------------------------------------------ */
  /*  EDIT DISCOUNT PRICE OR QTY IN ROW                                 */
  /* ------------------------------------------------------------------ */
  document.getElementById('items-tbody').addEventListener('input', function (e) {
    const tr  = e.target.closest('tr');
    if (!tr) return;
    const idx  = parseInt(e.target.dataset.idx);
    const type = e.target.dataset.type;

    if (e.target.classList.contains('row-disc-price') && type === 'bill') {
      billItems[idx].discountedPrice = parseFloat(e.target.value) || 0;
      const ltCell = tr.querySelector('.row-line-total');
      if (ltCell) ltCell.textContent = 'Rs ' + fmt(lineTotal(billItems[idx]));
      updateGrandTotal();
    }
    else if (e.target.classList.contains('row-qty') && type === 'bill') {
      billItems[idx].qty = Math.max(1, parseInt(e.target.value) || 1);
      const ltCell = tr.querySelector('.row-line-total');
      if (ltCell) ltCell.textContent = 'Rs ' + fmt(lineTotal(billItems[idx]));
      updateGrandTotal();
    }
    else if (e.target.classList.contains('row-qty') && type === 'return') {
      const idx = parseInt(e.target.dataset.idx);
      returnItems[idx].qty = Math.max(1, parseInt(e.target.value) || 1);
      const defaultVal = returnItems[idx].discountedPrice > 0 ? returnItems[idx].discountedPrice : returnItems[idx].price;
      const soldVal = returnItems[idx].soldFor > 0 ? returnItems[idx].soldFor : defaultVal;
      const ltCell = tr.querySelector('.row-return-total');
      const totalVal = soldVal * returnItems[idx].qty;
      if (ltCell) ltCell.textContent = '- Rs ' + fmt(totalVal);
      updateGrandTotal();
    }
    else if (e.target.classList.contains('row-return-disc')) {
      const idx = parseInt(e.target.dataset.idx);
      const newDisc = parseFloat(e.target.value) || 0;
      returnItems[idx].discountedPrice = newDisc;
      
      // Live sync Sold For: if Disc Price entered (>0) show Disc Price, else show regular Price
      const newSold = newDisc > 0 ? newDisc : returnItems[idx].price;
      returnItems[idx].soldFor = newSold;
      const soldInp = tr.querySelector('.row-sold-for');
      if (soldInp) soldInp.value = newSold > 0 ? newSold : '';

      const ltCell = tr.querySelector('.row-return-total');
      if (ltCell) ltCell.textContent = '- Rs ' + fmt(newSold * returnItems[idx].qty);
      updateGrandTotal();
    }
    else if (e.target.classList.contains('row-sold-for')) {
      const idx = parseInt(e.target.dataset.idx);
      const val = parseFloat(e.target.value) || 0;
      const defaultVal = returnItems[idx].discountedPrice > 0 ? returnItems[idx].discountedPrice : returnItems[idx].price;
      // If user typed custom value, use it. If cleared, revert to defaultVal
      const finalVal = val > 0 ? val : defaultVal;
      returnItems[idx].soldFor = val > 0 ? val : finalVal;
      
      const ltCell = tr.querySelector('.row-return-total');
      if (ltCell) ltCell.textContent = '- Rs ' + fmt(finalVal * returnItems[idx].qty);
      updateGrandTotal();
    }
  });

  /* ------------------------------------------------------------------ */
  /*  QTY +/-                                                             */
  /* ------------------------------------------------------------------ */
  document.getElementById('qty-dec').addEventListener('click', function () {
    const inp = document.getElementById('f-qty');
    inp.value = Math.max(1, (parseInt(inp.value) || 1) - 1);
  });
  document.getElementById('qty-inc').addEventListener('click', function () {
    const inp = document.getElementById('f-qty');
    inp.value = (parseInt(inp.value) || 1) + 1;
  });

  /* ------------------------------------------------------------------ */
  /*  PRINT SIZE TOGGLE                                                   */
  /* ------------------------------------------------------------------ */
  document.getElementById('print-size-group').addEventListener('click', function (e) {
    const btn = e.target.closest('[data-size]');
    if (!btn) return;
    selectedSize = btn.dataset.size;
    document.querySelectorAll('#print-size-group .btn').forEach(function (b) {
      const isSel = (b === btn);
      b.classList.toggle('active', isSel);
      if (isSel) {
        b.classList.add('btn-dark');
        b.classList.remove('btn-outline-dark');
      } else {
        b.classList.remove('btn-dark');
        b.classList.add('btn-outline-dark');
      }
    });
  });

  /* ------------------------------------------------------------------ */
  /*  SAVE & PRINT                                                        */
  /* ------------------------------------------------------------------ */
  document.getElementById('btn-save-print').addEventListener('click', function () {
    if (!billItems.length) {
      toastr.warning('No items in the bill.');
      return;
    }

    // Validate Payment Method (compulsory)
    const paymentMethod = document.getElementById('cust-payment-method').value;
    if (!paymentMethod) {
      document.getElementById('payment-method-err').classList.remove('d-none');
      document.getElementById('cust-payment-method').focus();
      toastr.error('Please select a Payment Method before printing.');
      return;
    }
    document.getElementById('payment-method-err').classList.add('d-none');

    // Populate slip
    document.getElementById('slip-datetime').textContent = now();

    const slipTbody = document.getElementById('slip-tbody');
    slipTbody.innerHTML = '';
    let grand = 0;

    // Normal items
    billItems.forEach(function (item, idx) {
      const lt = lineTotal(item);
      grand += lt;
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${idx + 1}</td>
        <td>${escHtml(item.name)}</td>
        <td>${escHtml(item.category)}</td>
        <td>${escHtml(item.pieceType)}</td>
        <td class="text-center">${item.qty}</td>
        <td class="text-right">${fmt(item.price)}</td>
        <td class="text-right">${item.discountedPrice > 0 ? fmt(item.discountedPrice) : ''}</td>
        <td class="text-right">${fmt(lt)}</td>`;
      slipTbody.appendChild(tr);
    });

    // Returned items (conditional)
    let returnTotal = 0;
    if (returnItems.length > 0) {
      // Clean, professional section divider
      const divTr = document.createElement('tr');
      divTr.innerHTML = `<td colspan="8" style="padding:7px 2px 4px;border-top:1px dashed #000;border-bottom:1px dashed #000;font-weight:900;font-size:9.5pt;letter-spacing:0.5px;">&#8617; RETURNED ITEMS</td>`;
      slipTbody.appendChild(divTr);

      returnItems.forEach(function (item, idx) {
        const defaultVal = item.discountedPrice > 0 ? item.discountedPrice : item.price;
        const soldVal = item.soldFor > 0 ? item.soldFor : defaultVal;
        const lt = soldVal * item.qty;
        returnTotal += lt;
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>R${idx + 1}</td>
          <td>${escHtml(item.name)}</td>
          <td>${escHtml(item.category)}</td>
          <td>${escHtml(item.pieceType || '—')}</td>
          <td class="text-center">${item.qty}</td>
          <td class="text-right">${item.price > 0 ? fmt(item.price) : '—'}</td>
          <td class="text-right">${soldVal > 0 ? fmt(soldVal) : '—'}</td>
          <td class="text-right">- ${fmt(lt)}</td>`;
        slipTbody.appendChild(tr);
      });
    }

    const finalGrand = Math.max(0, grand - returnTotal);
    document.getElementById('slip-grand').textContent = 'Rs ' + fmt(finalGrand);

    // --- Customer Details ---
    const custName  = document.getElementById('cust-name').value.trim();
    const custPhone = document.getElementById('cust-phone').value.trim();
    const custCity  = document.getElementById('cust-city').value.trim();
    const custDiscTotal = parseFloat(document.getElementById('cust-discount-total').value) || 0;

    const custBlock = document.getElementById('slip-cust-block');
    if (custName || custPhone || custCity) {
      custBlock.style.display = 'block';
      document.getElementById('slip-cust-name').textContent  = custName  ? 'Customer: ' + custName  : '';
      document.getElementById('slip-cust-phone').textContent = custPhone ? 'Phone: '    + custPhone : '';
      document.getElementById('slip-cust-city').textContent  = custCity  ? 'City: '     + custCity  : '';
    } else {
      custBlock.style.display = 'none';
    }

    // --- Discounted Total Row ---
    const discRow = document.getElementById('slip-disc-row');
    if (custDiscTotal > 0) {
      discRow.style.display = '';
      document.getElementById('slip-disc-total').textContent = 'Rs ' + fmt(custDiscTotal);
    } else {
      discRow.style.display = 'none';
    }

    // --- Payment Method ---
    document.getElementById('slip-payment-method').textContent = paymentMethod;

    // --- Amount Paid & Outstanding Balance ---
    const amountPaid = parseFloat(document.getElementById('cust-amount-paid').value) || 0;
    const baseForBalance = custDiscTotal > 0 ? custDiscTotal : finalGrand;
    const remaining = baseForBalance - amountPaid;

    const paidRow = document.getElementById('slip-paid-row');
    const remRow  = document.getElementById('slip-remaining-row');

    const isFullUdhaar = (paymentMethod === 'Remaining (Udhaar)' && amountPaid === 0);

    if (amountPaid > 0 || isFullUdhaar) {
      paidRow.style.display = '';
      document.getElementById('slip-amount-paid').textContent = 'Rs ' + fmt(amountPaid);
    } else {
      paidRow.style.display = 'none';
    }

    if ((amountPaid > 0 && remaining > 0) || isFullUdhaar) {
      remRow.style.display = '';
      document.getElementById('slip-remaining').textContent = 'Rs ' + fmt(isFullUdhaar ? baseForBalance : remaining);
    } else {
      remRow.style.display = 'none';
    }

    // Apply size class to body
    document.body.classList.remove('print-3inch', 'print-4inch');
    document.body.classList.add('print-' + selectedSize);

    // Show slip div (needed for print visibility rules)
    const slip = document.getElementById('print-slip');
    slip.style.display = 'block';

    window.print();

    // Hide again after print dialog closes
    setTimeout(function () { slip.style.display = 'none'; }, 500);
  });


