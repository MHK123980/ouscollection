<!-- =========================================================
     CREATE BILL  –  POS Page
     Requires: Bootstrap 5, FontAwesome 6, jQuery (from layout)
     ========================================================= -->

<!-- html5-qrcode CDN -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<style>
  /* ---- Page Layout ---- */
  #bill-page { max-width: 1100px; margin: 0 auto; }

  /* ---- Items Table ---- */
  #items-wrapper {
    max-height: 340px;
    overflow-y: auto;
    border: 1px solid #dee2e6;
    border-radius: 6px;
  }
  #items-table thead th {
    position: sticky;
    top: 0;
    background: #343a40;
    color: #fff;
    font-size: .78rem;
    white-space: nowrap;
    z-index: 2;
  }
  #items-table tbody tr:nth-child(odd)  { background: #f8f9fa; }
  #items-table tbody tr:nth-child(even) { background: #ffffff; }
  #items-table tbody tr { font-size: .82rem; }
  #items-table .btn-remove { line-height: 1; padding: 1px 6px; }

  /* ---- Grand Total badge ---- */
  #grand-total-badge { font-size: 1.1rem; min-width: 120px; text-align: right; }

  /* ---- Manual form ---- */
  #manual-form label { font-size: .82rem; font-weight: 600; }
  #manual-form .form-control,
  #manual-form .form-select { font-size: .84rem; }

  /* ---- Qty control ---- */
  .qty-control { display: flex; align-items: center; gap: 4px; }
  .qty-control button { width: 30px; height: 30px; padding: 0; font-size: 1rem; line-height: 1; }
  .qty-control input  { width: 50px; text-align: center; font-size: .84rem; }

  /* ---- Camera Overlay ---- */
  #camera-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.82);
    z-index: 9999;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  #camera-overlay.active { display: flex; }
  #qr-reader {
    width: min(94vw, 420px);
    border-radius: 10px;
    overflow: hidden;
    background: #000;
  }
  #scan-status {
    margin-top: 14px;
    font-size: .95rem;
    color: #fff;
    min-height: 28px;
    text-align: center;
  }
  #scan-flash {
    position: fixed;
    inset: 0;
    background: rgba(40,200,80,.35);
    pointer-events: none;
    opacity: 0;
    transition: opacity .25s;
    z-index: 10000;
  }
  #scan-flash.show { opacity: 1; }

  /* ---- Print size btn-group ---- */
  #print-size-group .btn { min-width: 90px; }

  /* ---- PRINT STYLES ---- */
  @media print {
    /* Hide everything by default */
    body * { visibility: hidden !important; }

    /* Show only slip */
    #print-slip, #print-slip * { visibility: visible !important; }
    #print-slip {
      position: fixed !important;
      top: 0; left: 0;
      width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
      background: #fff;
      color: #000;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    /* Size variants applied via body class */
    body.print-3inch #print-slip { max-width: 80mm !important; }
    body.print-4inch #print-slip { max-width: 104mm !important; }

    #print-slip .slip-header { text-align: center; margin-bottom: 10px; border-bottom: 1px dashed #000; padding-bottom: 8px; }
    #print-slip .slip-logo { max-width: 70px; margin-bottom: 5px; }
    #print-slip .slip-shop { font-size: 16pt; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 2px; }
    #print-slip .slip-subtitle { font-size: 8pt; font-weight: 600; margin-bottom: 4px; }
    #print-slip .slip-datetime { font-size: 8pt; color: #333; }

    #print-slip table { width: 100% !important; border-collapse: collapse; margin-bottom: 10px; }
    #print-slip th { border-bottom: 1px solid #000; border-top: 1px solid #000; padding: 4px 2px; font-size: 8pt; text-align: left; }
    #print-slip td { padding: 4px 2px; font-size: 8pt; border-bottom: 1px dotted #ccc; }
    
    #print-slip .text-right { text-align: right !important; }
    #print-slip .text-center { text-align: center !important; }
    
    #print-slip tfoot tr td { border-top: 1px dashed #000; border-bottom: none; font-size: 9pt; padding-top: 6px; }
    #print-slip .slip-grand { font-weight: 900; font-size: 12pt; text-align: right; }

    #print-slip .slip-footer { text-align: center; margin-top: 15px; border-top: 1px dashed #000; padding-top: 10px; font-size: 8pt; }
    #print-slip .slip-footer-thanks { font-weight: bold; font-size: 10pt; margin-bottom: 4px; }
  }
</style>

<!-- ===== MAIN PAGE ===== -->
<div id="bill-page" class="container-fluid py-3">

  <!-- Page Header -->
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="mb-0 fw-bold"><i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i>Create Bill</h4>
    <span class="badge bg-success fs-6" id="grand-total-badge">Total: Rs 0.00</span>
  </div>

  <!-- ===== BILL ITEMS LIST ===== -->
  <div id="items-wrapper" class="mb-3">
    <table class="table table-sm mb-0" id="items-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Item Name</th>
          <th>Category</th>
          <th>Piece</th>
          <th>Qty</th>
          <th>Price</th>
          <th>Disc. Price</th>
          <th>Line Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="items-tbody">
        <tr id="empty-row">
          <td colspan="9" class="text-center text-muted py-3">
            <i class="fa-solid fa-cart-plus me-2"></i>No items added yet
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- ===== MANUAL ADD FORM ===== -->
  <div class="card mb-3 shadow-sm" id="manual-form">
    <div class="card-header bg-dark text-white py-2 d-flex align-items-center justify-content-between">
      <span><i class="fa-solid fa-pen-to-square me-2"></i>Manual Entry</span>
      <button class="btn btn-sm btn-outline-light" id="btn-open-scan">
        <i class="fa-solid fa-camera me-1"></i>Create Bill via Scan
      </button>
    </div>
    <div class="card-body py-3">
      <div class="row g-2 align-items-end">

        <!-- Item Name -->
        <div class="col-12 col-sm-6 col-md-3">
          <label for="f-name">Item Name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="f-name" placeholder="e.g. Zellbury Shirt">
        </div>

        <!-- Category -->
        <div class="col-12 col-sm-6 col-md-2">
          <label for="f-category">Category</label>
          <select class="form-select" id="f-category">
            <option value="">-- Select --</option>
            <% if (typeof allCategories !== 'undefined' && allCategories.length) { %>
              <% allCategories.forEach(function(cat){ %>
                <option value="<%= cat.categoryName %>"><%= cat.categoryName %></option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Price -->
        <div class="col-6 col-sm-4 col-md-2">
          <label for="f-price">Price <span class="text-danger">*</span></label>
          <input type="number" class="form-control" id="f-price" placeholder="0" min="0" step="0.01">
        </div>

        <!-- Discounted Price -->
        <div class="col-6 col-sm-4 col-md-2">
          <label for="f-disc">Discounted Price</label>
          <input type="number" class="form-control" id="f-disc" placeholder="0" min="0" step="0.01">
        </div>

        <!-- Piece Type -->
        <div class="col-6 col-sm-4 col-md-1">
          <label for="f-piece">Piece</label>
          <select class="form-select" id="f-piece">
            <option value="">--</option>
            <% ['1pc','2pc','3pc','4pc','5pc','6pc','7pc','8pc','9pc','10pc'].forEach(function(p){ %>
              <option value="<%= p %>"><%= p %></option>
            <% }); %>
          </select>
        </div>

        <!-- Quantity -->
        <div class="col-6 col-sm-4 col-md-1">
          <label>Qty</label>
          <div class="qty-control">
            <button class="btn btn-outline-secondary btn-sm" id="qty-dec" type="button">−</button>
            <input type="number" class="form-control" id="f-qty" value="1" min="1">
            <button class="btn btn-outline-secondary btn-sm" id="qty-inc" type="button">+</button>
          </div>
        </div>

        <!-- Add Button -->
        <div class="col-12 col-md-1 d-flex align-items-end">
          <button class="btn btn-primary w-100" id="btn-add-item" type="button">
            <i class="fa-solid fa-plus me-1"></i>Add
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- ===== OPTIONAL CUSTOMER DETAILS ===== -->
  <div class="card shadow-sm mb-3" id="customer-details-card">
    <div class="card-header py-2" style="background:#f8f9fa;">
      <i class="fa-solid fa-user me-2 text-secondary"></i>
      <span class="fw-semibold small text-secondary">Customer Details</span>
      <span class="badge bg-secondary ms-2" style="font-size:10px;">Optional</span>
    </div>
    <div class="card-body py-2">
      <div class="row g-2">
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1">Customer Name</label>
          <input type="text" class="form-control form-control-sm" id="cust-name" placeholder="e.g. Ahmed Khan">
        </div>
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1">Phone No</label>
          <input type="text" class="form-control form-control-sm" id="cust-phone" placeholder="e.g. 0300-1234567">
        </div>
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1">City</label>
          <input type="text" class="form-control form-control-sm" id="cust-city" placeholder="e.g. Lahore">
        </div>
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1 text-danger fw-bold">Total Discounted Amount</label>
          <div class="input-group input-group-sm">
            <span class="input-group-text">Rs</span>
            <input type="number" class="form-control" id="cust-discount-total" placeholder="Amount to collect" min="0" step="0.01">
          </div>
          <small class="text-muted" style="font-size:10px;">If entered, shows on bill as final payable amount</small>
        </div>

        <!-- Amount Paid -->
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1">Amount Paid <span class="badge bg-secondary" style="font-size:9px;">Optional</span></label>
          <div class="input-group input-group-sm">
            <span class="input-group-text">Rs</span>
            <input type="number" class="form-control" id="cust-amount-paid" placeholder="e.g. 2000" min="0" step="0.01" oninput="calcRemainingBalance()">
          </div>
        </div>

        <!-- Remaining Balance (auto-calculated, read-only) -->
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1">Outstanding Balance <span class="badge bg-secondary" style="font-size:9px;">Auto</span></label>
          <div class="input-group input-group-sm">
            <span class="input-group-text">Rs</span>
            <input type="number" class="form-control" id="cust-remaining" placeholder="0.00" readonly style="background:#f8f9fa;">
          </div>
          <small class="text-muted" style="font-size:10px;">Grand Total &minus; Amount Paid</small>
        </div>

        <!-- Payment Method (Compulsory) -->
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1 fw-bold">Payment Method <span class="text-danger">*</span></label>
          <select class="form-select form-select-sm" id="cust-payment-method">
            <option value="">-- Select Method --</option>
            <option value="Cash">Cash</option>
            <option value="Online">Online</option>
            <option value="Remaining (Udhaar)">Remaining (Udhaar)</option>
          </select>
          <small class="text-danger d-none" id="payment-method-err" style="font-size:10px;">Please select a payment method</small>
        </div>

      </div>
    </div>
  </div>

  <!-- ===== BOTTOM ACTIONS ===== -->
  <div class="card shadow-sm">
    <div class="card-body bg-dark rounded d-flex flex-wrap align-items-center gap-3">

      <!-- Print size selector -->
      <div>
        <span class="text-white me-2 fw-semibold small">Print Size:</span>
        <div class="btn-group" id="print-size-group" role="group">
          <button type="button" class="btn btn-sm btn-light active" data-size="3inch">3 Inch</button>
          <button type="button" class="btn btn-sm btn-outline-light"  data-size="4inch">4 Inch</button>
        </div>
      </div>

      <button class="btn btn-success ms-auto" id="btn-save-print" type="button">
        <i class="fa-solid fa-print me-2"></i>Save & Print Slip
      </button>

    </div>
  </div>

</div><!-- /bill-page -->

<!-- ===== CAMERA OVERLAY ===== -->
<div id="camera-overlay">
  <div id="qr-reader"></div>
  <div id="scan-status">Point camera at a QR code…</div>
  <button class="btn btn-danger mt-3" id="btn-stop-scan">
    <i class="fa-solid fa-stop me-2"></i>Stop Scanning
  </button>
</div>

<!-- Flash on scan -->
<div id="scan-flash"></div>

<!-- ===== PRINT SLIP (hidden until print) ===== -->
<div id="print-slip" style="display:none;">
  <div class="slip-header">
    <img src="/img/ous-logo.png" class="slip-logo" alt="Logo" style="max-width: 90px; margin-bottom: 5px;">
    <div style="font-size: 9pt; font-weight: bold; margin-bottom: 4px;">0324 3503152</div>
    <div class="slip-subtitle">LADIES &amp; GENTS FASHION</div>
    <div class="slip-subtitle">WHOLESALE &amp; RETAIL</div>
    <div class="slip-datetime" id="slip-datetime"></div>
  </div>

  <!-- Customer info (shown only if filled) -->
  <div id="slip-cust-block" style="display:none; border-bottom:1px dashed #000; padding-bottom:6px; margin-bottom:6px; font-size:8pt;">
    <div id="slip-cust-name"></div>
    <div id="slip-cust-phone"></div>
    <div id="slip-cust-city"></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Item</th>
        <th>Cat</th>
        <th>Pc</th>
        <th class="text-center">Qty</th>
        <th class="text-right">Price</th>
        <th class="text-right">Disc</th>
        <th class="text-right">Total</th>
      </tr>
    </thead>
    <tbody id="slip-tbody"></tbody>
    <tfoot>
      <tr>
        <td colspan="7" class="text-right" style="font-weight:bold;">Grand Total:</td>
        <td class="slip-grand" id="slip-grand"></td>
      </tr>
      <!-- Discounted total row: shown only if entered -->
      <tr id="slip-disc-row" style="display:none;">
        <td colspan="7" class="text-right" style="font-weight:900; font-size:11pt; color:#c00;">Amount to Pay:</td>
        <td style="font-weight:900; font-size:11pt; color:#c00;" id="slip-disc-total"></td>
      </tr>
      <!-- Payment Method row -->
      <tr id="slip-payment-row">
        <td colspan="7" class="text-right" style="font-weight:bold;">Payment Method:</td>
        <td style="font-weight:bold;" id="slip-payment-method"></td>
      </tr>
      <!-- Amount Paid row: shown only if entered -->
      <tr id="slip-paid-row" style="display:none;">
        <td colspan="7" class="text-right" style="font-weight:bold; color:#007700;">Amount Received:</td>
        <td style="font-weight:bold; color:#007700;" id="slip-amount-paid"></td>
      </tr>
      <!-- Remaining Balance row: shown only if > 0 -->
      <tr id="slip-remaining-row" style="display:none;">
        <td colspan="7" class="text-right" style="font-weight:900; font-size:10pt; color:#c00;">Outstanding Balance:</td>
        <td style="font-weight:900; font-size:10pt; color:#c00;" id="slip-remaining"></td>
      </tr>
    </tfoot>
  </table>
  <div class="slip-footer">
    <div class="slip-footer-thanks">Thanks For Choosing OUS Collection</div>
    <div style="font-weight: bold; margin-bottom: 6px; font-size: 9pt;">Please Shop Again!</div>
    <div>Powered By MHT Devs</div>
  </div>
</div>

<!-- ===== PAGE SCRIPT ===== -->
<script>
// Global: called from oninput attribute on Amount Paid field
function calcRemainingBalance() {
  // Access billItems from the enclosing scope via a module-level getter
  const rows = document.querySelectorAll('#items-tbody tr.bill-item-row');
  // Simpler: compute from DOM line totals
  let grand = 0;
  document.querySelectorAll('.row-line-total').forEach(function(cell) {
    const val = cell.textContent.replace(/[^0-9.]/g,'');
    grand += parseFloat(val) || 0;
  });
  const discTotal = parseFloat(document.getElementById('cust-discount-total').value) || 0;
  const baseAmt   = discTotal > 0 ? discTotal : grand;
  const paid      = parseFloat(document.getElementById('cust-amount-paid').value) || 0;
  const rem       = Math.max(0, baseAmt - paid);
  document.getElementById('cust-remaining').value = paid > 0 ? rem.toFixed(2) : '';
}

(function () {
  'use strict';

  /* ------------------------------------------------------------------ */
  /*  STATE                                                               */
  /* ------------------------------------------------------------------ */
  let billItems = [];
  let selectedSize = '3inch';
  let html5QrCode = null;
  let scannerRunning = false;
  let lastScannedCode = '';   // debounce same code scanned twice
  let lastScanTime = 0;

  /* ------------------------------------------------------------------ */
  /*  HELPERS                                                             */
  /* ------------------------------------------------------------------ */
  const fmt = v => parseFloat(v || 0).toFixed(2);

  function lineTotal(item) {
    const unitPrice = item.discountedPrice > 0 ? item.discountedPrice : item.price;
    return unitPrice * item.qty;
  }

  function now() {
    return new Date().toLocaleString('en-PK', {
      dateStyle: 'medium', timeStyle: 'short'
    });
  }

  /* ------------------------------------------------------------------ */
  /*  RENDER BILL TABLE                                                   */
  /* ------------------------------------------------------------------ */
  function renderTable() {
    const tbody = document.getElementById('items-tbody');
    tbody.innerHTML = '';

    if (!billItems.length) {
      tbody.innerHTML = `<tr id="empty-row">
        <td colspan="9" class="text-center text-muted py-3">
          <i class="fa-solid fa-cart-plus me-2"></i>No items added yet
        </td></tr>`;
      updateGrandTotal();
      return;
    }

    billItems.forEach(function (item, idx) {
      const lt = lineTotal(item);
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${idx + 1}</td>
        <td>${escHtml(item.name)}</td>
        <td>${escHtml(item.category)}</td>
        <td>${escHtml(item.pieceType)}</td>
        <td>
          <input type="number" class="form-control form-control-sm row-qty" 
                 data-idx="${idx}" 
                 value="${item.qty}" 
                 min="1" step="1"
                 style="width: 50px; padding: 2px 4px; font-size: 12px; height: 26px;">
        </td>
        <td>Rs ${fmt(item.price)}</td>
        <td>
          <input type="number" class="form-control form-control-sm row-disc-price" 
                 data-idx="${idx}" 
                 value="${item.discountedPrice > 0 ? item.discountedPrice : ''}" 
                 placeholder="0.00" 
                 min="0" step="0.01"
                 style="width: 80px; padding: 2px 4px; font-size: 12px; height: 26px;">
        </td>
        <td class="row-line-total">Rs ${fmt(lt)}</td>
        <td>
          <button class="btn btn-danger btn-sm btn-remove" data-idx="${idx}">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </td>`;
      tbody.appendChild(tr);
    });

    updateGrandTotal();
  }

  function updateGrandTotal() {
    const total = billItems.reduce((s, i) => s + lineTotal(i), 0);
    document.getElementById('grand-total-badge').textContent = 'Total: Rs ' + fmt(total);
    // Keep remaining balance in sync
    if (document.getElementById('cust-amount-paid').value) {
      calcRemainingBalance();
    }
  }

  function escHtml(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  /* ------------------------------------------------------------------ */
  /*  READ FORM                                                           */
  /* ------------------------------------------------------------------ */
  function readForm() {
    return {
      name:           document.getElementById('f-name').value.trim(),
      category:       document.getElementById('f-category').value,
      price:          parseFloat(document.getElementById('f-price').value) || 0,
      discountedPrice:parseFloat(document.getElementById('f-disc').value)  || 0,
      pieceType:      document.getElementById('f-piece').value,
      qty:            parseInt(document.getElementById('f-qty').value)    || 1,
    };
  }

  function clearForm() {
    document.getElementById('f-name').value     = '';
    document.getElementById('f-category').value = '';
    document.getElementById('f-price').value    = '';
    document.getElementById('f-disc').value     = '';
    document.getElementById('f-piece').value    = '';
    document.getElementById('f-qty').value      = 1;
  }

  function fillForm(data) {
    if (data.name)           document.getElementById('f-name').value          = data.name;
    if (data.category)       document.getElementById('f-category').value      = data.category;
    if (data.price)          document.getElementById('f-price').value         = data.price;
    if (data.discountedPrice)document.getElementById('f-disc').value          = data.discountedPrice;
    if (data.pieceType)      document.getElementById('f-piece').value         = data.pieceType;
  }

  /* ------------------------------------------------------------------ */
  /*  ADD ITEM                                                            */
  /* ------------------------------------------------------------------ */
  function addItem(itemData) {
    billItems.push(itemData);
    renderTable();
    // scroll list to bottom
    const w = document.getElementById('items-wrapper');
    w.scrollTop = w.scrollHeight;
  }

  document.getElementById('btn-add-item').addEventListener('click', function () {
    const item = readForm();
    if (!item.name) {
      toastr.warning('Please enter an item name.');
      document.getElementById('f-name').focus();
      return;
    }
    addItem(item);
    clearForm();
    document.getElementById('f-name').focus();
  });

  /* ------------------------------------------------------------------ */
  /*  REMOVE ITEM (event delegation)                                      */
  /* ------------------------------------------------------------------ */
  document.getElementById('items-tbody').addEventListener('click', function (e) {
    const btn = e.target.closest('.btn-remove');
    if (!btn) return;
    const idx = parseInt(btn.dataset.idx);
    billItems.splice(idx, 1);
    renderTable();
  });

  /* ------------------------------------------------------------------ */
  /*  EDIT DISCOUNT PRICE OR QTY IN ROW                                 */
  /* ------------------------------------------------------------------ */
  document.getElementById('items-tbody').addEventListener('input', function (e) {
    const tr = e.target.closest('tr');
    if (!tr) return;

    if (e.target.classList.contains('row-disc-price')) {
      const idx = parseInt(e.target.dataset.idx);
      const val = parseFloat(e.target.value) || 0;
      billItems[idx].discountedPrice = val;
      
      const ltCell = tr.querySelector('.row-line-total');
      if (ltCell) {
        ltCell.textContent = 'Rs ' + fmt(lineTotal(billItems[idx]));
      }
      updateGrandTotal();
    }
    else if (e.target.classList.contains('row-qty')) {
      const idx = parseInt(e.target.dataset.idx);
      const val = parseInt(e.target.value) || 1;
      billItems[idx].qty = Math.max(1, val);
      
      const ltCell = tr.querySelector('.row-line-total');
      if (ltCell) {
        ltCell.textContent = 'Rs ' + fmt(lineTotal(billItems[idx]));
      }
      updateGrandTotal();
    }
  });

  /* ------------------------------------------------------------------ */
  /*  QTY +/-                                                             */
  /* ------------------------------------------------------------------ */
  document.getElementById('qty-dec').addEventListener('click', function () {
    const inp = document.getElementById('f-qty');
    inp.value = Math.max(1, (parseInt(inp.value) || 1) - 1);
  });
  document.getElementById('qty-inc').addEventListener('click', function () {
    const inp = document.getElementById('f-qty');
    inp.value = (parseInt(inp.value) || 1) + 1;
  });

  /* ------------------------------------------------------------------ */
  /*  PRINT SIZE TOGGLE                                                   */
  /* ------------------------------------------------------------------ */
  document.getElementById('print-size-group').addEventListener('click', function (e) {
    const btn = e.target.closest('[data-size]');
    if (!btn) return;
    selectedSize = btn.dataset.size;
    document.querySelectorAll('#print-size-group .btn').forEach(function (b) {
      b.classList.toggle('active',       b === btn);
      b.classList.toggle('btn-light',    b === btn);
      b.classList.toggle('btn-outline-light', b !== btn);
    });
  });

  /* ------------------------------------------------------------------ */
  /*  SAVE & PRINT                                                        */
  /* ------------------------------------------------------------------ */
  document.getElementById('btn-save-print').addEventListener('click', function () {
    if (!billItems.length) {
      toastr.warning('No items in the bill.');
      return;
    }

    // Validate Payment Method (compulsory)
    const paymentMethod = document.getElementById('cust-payment-method').value;
    if (!paymentMethod) {
      document.getElementById('payment-method-err').classList.remove('d-none');
      document.getElementById('cust-payment-method').focus();
      toastr.error('Please select a Payment Method before printing.');
      return;
    }
    document.getElementById('payment-method-err').classList.add('d-none');

    // Populate slip
    document.getElementById('slip-datetime').textContent = now();

    const slipTbody = document.getElementById('slip-tbody');
    slipTbody.innerHTML = '';
    let grand = 0;
    billItems.forEach(function (item, idx) {
      const lt = lineTotal(item);
      grand += lt;
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${idx + 1}</td>
        <td>${escHtml(item.name)}</td>
        <td>${escHtml(item.category)}</td>
        <td>${escHtml(item.pieceType)}</td>
        <td class="text-center">${item.qty}</td>
        <td class="text-right">${fmt(item.price)}</td>
        <td class="text-right">${item.discountedPrice > 0 ? fmt(item.discountedPrice) : ''}</td>
        <td class="text-right">${fmt(lt)}</td>`;
      slipTbody.appendChild(tr);
    });
    document.getElementById('slip-grand').textContent = 'Rs ' + fmt(grand);

    // --- Customer Details ---
    const custName  = document.getElementById('cust-name').value.trim();
    const custPhone = document.getElementById('cust-phone').value.trim();
    const custCity  = document.getElementById('cust-city').value.trim();
    const custDiscTotal = parseFloat(document.getElementById('cust-discount-total').value) || 0;

    const custBlock = document.getElementById('slip-cust-block');
    if (custName || custPhone || custCity) {
      custBlock.style.display = 'block';
      document.getElementById('slip-cust-name').textContent  = custName  ? 'Customer: ' + custName  : '';
      document.getElementById('slip-cust-phone').textContent = custPhone ? 'Phone: '    + custPhone : '';
      document.getElementById('slip-cust-city').textContent  = custCity  ? 'City: '     + custCity  : '';
    } else {
      custBlock.style.display = 'none';
    }

    // --- Discounted Total Row ---
    const discRow = document.getElementById('slip-disc-row');
    if (custDiscTotal > 0) {
      discRow.style.display = '';
      document.getElementById('slip-disc-total').textContent = 'Rs ' + fmt(custDiscTotal);
    } else {
      discRow.style.display = 'none';
    }

    // --- Payment Method ---
    document.getElementById('slip-payment-method').textContent = paymentMethod;

    // --- Amount Paid & Outstanding Balance ---
    const amountPaid = parseFloat(document.getElementById('cust-amount-paid').value) || 0;
    const baseForBalance = custDiscTotal > 0 ? custDiscTotal : grand;
    const remaining = baseForBalance - amountPaid;

    const paidRow = document.getElementById('slip-paid-row');
    const remRow  = document.getElementById('slip-remaining-row');

    const isFullUdhaar = (paymentMethod === 'Remaining (Udhaar)' && amountPaid === 0);

    if (amountPaid > 0 || isFullUdhaar) {
      paidRow.style.display = '';
      document.getElementById('slip-amount-paid').textContent = 'Rs ' + fmt(amountPaid);
    } else {
      paidRow.style.display = 'none';
    }

    if ((amountPaid > 0 && remaining > 0) || isFullUdhaar) {
      remRow.style.display = '';
      document.getElementById('slip-remaining').textContent = 'Rs ' + fmt(isFullUdhaar ? baseForBalance : remaining);
    } else {
      remRow.style.display = 'none';
    }

    // Apply size class to body
    document.body.classList.remove('print-3inch', 'print-4inch');
    document.body.classList.add('print-' + selectedSize);

    // Show slip div (needed for print visibility rules)
    const slip = document.getElementById('print-slip');
    slip.style.display = 'block';

    window.print();

    // Hide again after print dialog closes
    setTimeout(function () { slip.style.display = 'none'; }, 500);
  });

  /* ------------------------------------------------------------------ */
  /*  CAMERA / QR SCANNER                                                 */
  /* ------------------------------------------------------------------ */
  function showFlash() {
    const flash = document.getElementById('scan-flash');
    flash.classList.add('show');
    setTimeout(function () { flash.classList.remove('show'); }, 280);
  }

  function setScanStatus(msg, color) {
    const el = document.getElementById('scan-status');
    el.textContent = msg;
    el.style.color = color || '#fff';
  }

  function onScanSuccess(decodedText) {
    const now_ms = Date.now();
    // Debounce: skip if same code within 1500ms
    if (decodedText === lastScannedCode && now_ms - lastScanTime < 1500) return;
    lastScannedCode = decodedText;
    lastScanTime = now_ms;

    let data = {};
    let barcodeNum = '';

    // Parse BCODE:<num>|<json> format from createBarcode page
    if (decodedText.startsWith('BCODE:')) {
      const pipeIdx = decodedText.indexOf('|');
      if (pipeIdx > 6) {
        barcodeNum = decodedText.substring(6, pipeIdx);
        try { data = JSON.parse(decodedText.substring(pipeIdx + 1)); } catch(e) { data = {}; }
      } else {
        barcodeNum = decodedText.substring(6);
      }
    } else {
      // Legacy plain-JSON or raw text
      try { data = JSON.parse(decodedText); } catch (e) { data = { n: decodedText }; }
    }

    // Auto-add with qty 1, keep scanner open
    const itemName  = data.name || data.n || barcodeNum || '';
    const itemCat   = data.category || data.c || '';
    const itemPrice = parseFloat(data.price || data.p) || 0;
    const itemDisc  = parseFloat(data.discountedPrice || data.d) || 0;
    const itemPiece = data.pieceType || data.pt || '';

    addItem({
      name:            itemName,
      category:        itemCat,
      price:           itemPrice,
      discountedPrice: itemDisc,
      pieceType:       itemPiece,
      qty: 1,
    });

    showFlash();
    setScanStatus('✔ Added: ' + (itemName || barcodeNum || 'item'), '#6aff9b');
    setTimeout(function () { setScanStatus('Point camera at barcode…'); }, 1800);
  }

  function onScanFailure() { /* silent */ }

  function openScanner() {
    if (scannerRunning) return;
    document.getElementById('camera-overlay').classList.add('active');
    setScanStatus('Starting camera…');

    html5QrCode = new Html5Qrcode('qr-reader');
    const config = {
      fps: 15,
      qrbox: { width: 260, height: 260 },
      aspectRatio: 1.0,
    };
    html5QrCode.start(
      { facingMode: 'environment' },
      config,
      onScanSuccess,
      onScanFailure
    ).then(function () {
      scannerRunning = true;
      setScanStatus('Point camera at a QR code…');
    }).catch(function (err) {
      setScanStatus('Camera error: ' + err, '#ff6b6b');
      console.error('QR scanner start error:', err);
    });
  }

  function stopScanner() {
    if (!scannerRunning || !html5QrCode) return;
    html5QrCode.stop().then(function () {
      html5QrCode = null;
      scannerRunning = false;
      document.getElementById('camera-overlay').classList.remove('active');
    }).catch(function (err) {
      console.error('QR scanner stop error:', err);
      document.getElementById('camera-overlay').classList.remove('active');
    });
  }

  document.getElementById('btn-open-scan').addEventListener('click', openScanner);
  document.getElementById('btn-stop-scan').addEventListener('click', stopScanner);

  // Keep remaining balance in sync when discount total changes
  document.getElementById('cust-discount-total').addEventListener('input', calcRemainingBalance);

  // Initial render
  renderTable();

})();
</script>
