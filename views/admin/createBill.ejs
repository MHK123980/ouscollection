<!-- =========================================================
     CREATE BILL  –  POS Page
     Requires: Bootstrap 5, FontAwesome 6, jQuery (from layout)
     ========================================================= -->

<!-- html5-qrcode CDN -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
  /* ---- Page Layout ---- */
  #bill-page { max-width: 1100px; margin: 0 auto; }

  /* ---- Items Table ---- */
  #items-wrapper {
    max-height: 340px;
    overflow-y: auto;
    border: 1px solid #dee2e6;
    border-radius: 6px;
  }
  #items-table thead th {
    position: sticky;
    top: 0;
    background: #343a40;
    color: #fff;
    font-size: .78rem;
    white-space: nowrap;
    z-index: 2;
  }
  #items-table tbody tr:nth-child(odd)  { background: #f8f9fa; }
  #items-table tbody tr:nth-child(even) { background: #ffffff; }
  #items-table tbody tr { font-size: .82rem; }
  #items-table .btn-remove { line-height: 1; padding: 1px 6px; }

  /* ---- Grand Total badge ---- */
  #grand-total-badge { font-size: 1.1rem; min-width: 120px; text-align: right; }

  /* ---- Manual form ---- */
  #manual-form label { font-size: .82rem; font-weight: 600; }
  #manual-form .form-control,
  #manual-form .form-select { font-size: .84rem; }

  /* ---- Qty control ---- */
  .qty-control { display: flex; align-items: center; gap: 4px; }
  .qty-control button { width: 30px; height: 30px; padding: 0; font-size: 1rem; line-height: 1; }
  .qty-control input  { width: 50px; text-align: center; font-size: .84rem; }

  /* ---- Camera Overlay ---- */
  #camera-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.82);
    z-index: 9999;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  #camera-overlay.active { display: flex; }
  #qr-reader {
    width: min(94vw, 420px);
    border-radius: 10px;
    overflow: hidden;
    background: #000;
  }
  #scan-status {
    margin-top: 14px;
    font-size: .95rem;
    color: #fff;
    min-height: 28px;
    text-align: center;
  }
  #scan-flash {
    position: fixed;
    inset: 0;
    background: rgba(40,200,80,.35);
    pointer-events: none;
    opacity: 0;
    transition: opacity .25s;
    z-index: 10000;
  }
  #scan-flash.show { opacity: 1; }

  /* ---- Print size btn-group ---- */
  #print-size-group .btn { min-width: 90px; }

  /* ---- PRINT SLIP BASE STYLES (Clean, Spacious, Professional Thermal Receipt) ---- */
  #print-slip {
    background: #fff;
    color: #000;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 8.5pt;
    line-height: 1.35;
    box-sizing: border-box;
    padding: 14px 10px;
    margin: 0 auto;
  }
  #print-slip.print-3inch, body.print-3inch #print-slip { width: 80mm !important; max-width: 80mm !important; }
  #print-slip.print-4inch, body.print-4inch #print-slip { width: 104mm !important; max-width: 104mm !important; }

  #print-slip .slip-header { text-align: center; margin-bottom: 12px; border-bottom: 1px dashed #222; padding-bottom: 10px; }
  #print-slip .slip-logo { max-width: 90px; height: auto; display: block; margin: 0 auto 6px auto; }
  #print-slip .slip-shop { font-size: 14pt; font-weight: 900; letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 3px; }
  #print-slip .slip-subtitle { font-size: 8.5pt; font-weight: 700; margin-bottom: 3px; }
  #print-slip .slip-datetime { font-size: 8.5pt; color: #222; margin-top: 5px; }

  #print-slip table { width: 100% !important; border-collapse: collapse; margin-top: 6px; margin-bottom: 12px; }
  #print-slip th { border-bottom: 1px solid #000; border-top: 1px solid #000; padding: 6px 2px; font-size: 8pt; text-align: left; font-weight: 700; }
  #print-slip td { padding: 5px 2px; font-size: 8.5pt; border-bottom: 1px dotted #ddd; }
  
  #print-slip .text-right { text-align: right !important; }
  #print-slip .text-center { text-align: center !important; }
  
  #print-slip tfoot tr td { border-top: 1px dashed #222; border-bottom: none; font-size: 9pt; padding: 7px 3px; }
  #print-slip .slip-grand { font-weight: 900; font-size: 13pt; white-space: nowrap; }

  #print-slip .slip-footer { text-align: center; margin-top: 16px; border-top: 1px dashed #222; padding-top: 10px; font-size: 8.5pt; }
  #print-slip .slip-footer-thanks { font-weight: 800; font-size: 10.5pt; margin-bottom: 4px; }

  /* ---- PRINT MEDIA ONLY ---- */
  @media print {
    body * { visibility: hidden !important; }
    #print-slip, #print-slip * { visibility: visible !important; }
    #print-slip {
      position: fixed !important;
      top: 0; left: 0;
      padding: 0 !important;
      margin: 0 !important;
    }
  }
</style>

<!-- ===== MAIN PAGE ===== -->
<div id="bill-page" class="container-fluid py-3">

  <!-- Page Header -->
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="mb-0 fw-bold"><i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i>Create Bill</h4>
    <span class="badge bg-success fs-6" id="grand-total-badge">Total: Rs 0.00</span>
  </div>

  <!-- ===== OPTIONAL CUSTOMER DETAILS ===== -->
  <div class="card shadow-sm mb-3" id="customer-details-card">
    <div class="card-header bg-dark text-white py-2 d-flex align-items-center">
      <i class="fa-solid fa-user me-2"></i>
      <span class="fw-semibold small">Customer Details</span>
      <span class="badge bg-secondary ms-2" style="font-size:10px;">Optional</span>
    </div>
    <div class="card-body py-2">
      <div class="row g-2">
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1">Customer Name</label>
          <input type="text" class="form-control form-control-sm" id="cust-name" placeholder="e.g. Ahmed Khan">
        </div>
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1">Phone No</label>
          <input type="text" class="form-control form-control-sm" id="cust-phone" placeholder="e.g. 0300-1234567">
        </div>
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1">City</label>
          <input type="text" class="form-control form-control-sm" id="cust-city" placeholder="e.g. Lahore">
        </div>
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1 text-danger fw-bold">Total Discounted Amount</label>
          <div class="input-group input-group-sm">
            <span class="input-group-text">Rs</span>
            <input type="number" class="form-control" id="cust-discount-total" placeholder="Amount to collect" min="0" step="0.01">
          </div>
          <small class="text-muted" style="font-size:10px;">If entered, shows on bill as final payable amount</small>
        </div>

        <!-- Amount Paid -->
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1">Amount Paid <span class="badge bg-secondary" style="font-size:9px;">Optional</span></label>
          <div class="input-group input-group-sm">
            <span class="input-group-text">Rs</span>
            <input type="number" class="form-control" id="cust-amount-paid" placeholder="e.g. 2000" min="0" step="0.01" oninput="calcRemainingBalance()">
          </div>
        </div>

        <!-- Remaining Balance (auto-calculated, read-only) -->
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1">Outstanding Balance <span class="badge bg-secondary" style="font-size:9px;">Auto</span></label>
          <div class="input-group input-group-sm">
            <span class="input-group-text">Rs</span>
            <input type="number" class="form-control" id="cust-remaining" placeholder="0.00" readonly style="background:#f8f9fa;">
          </div>
          <small class="text-muted" style="font-size:10px;">Grand Total &minus; Amount Paid</small>
        </div>

        <!-- Payment Method (Compulsory) -->
        <div class="col-12 col-sm-6 col-md-3">
          <label class="form-label small mb-1 fw-bold">Payment Method <span class="text-danger">*</span></label>
          <select class="form-select form-select-sm" id="cust-payment-method">
            <option value="">-- Select Method --</option>
            <option value="Cash">Cash</option>
            <option value="Online">Online</option>
            <option value="Remaining (Udhaar)">Remaining (Udhaar)</option>
          </select>
          <small class="text-danger d-none" id="payment-method-err" style="font-size:10px;">Please select a payment method</small>
        </div>

      </div>
    </div>

  <!-- ===== MANUAL ADD FORM ===== -->
  <div class="card mb-3 shadow-sm" id="manual-form">
    <div class="card-header bg-dark text-white py-2 d-flex align-items-center justify-content-between">
      <span><i class="fa-solid fa-pen-to-square me-2"></i>Manual Entry</span>
      <button class="btn btn-sm btn-outline-light" id="btn-open-scan">
        <i class="fa-solid fa-camera me-1"></i>Create Bill via Scan
      </button>
    </div>
    <div class="card-body py-3">
      <div class="row g-2 align-items-end">

        <!-- Item Name -->
        <div class="col-12 col-sm-6 col-md-3">
          <label for="f-name">Item Name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="f-name" placeholder="e.g. Zellbury Shirt">
        </div>

        <!-- Category -->
        <div class="col-12 col-sm-6 col-md-2">
          <label for="f-category">Category</label>
          <select class="form-select" id="f-category">
            <option value="">-- Select --</option>
            <% if (typeof allCategories !== 'undefined' && allCategories.length) { %>
              <% allCategories.forEach(function(cat){ %>
                <option value="<%= cat.categoryName %>"><%= cat.categoryName %></option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Price -->
        <div class="col-6 col-sm-4 col-md-2">
          <label for="f-price">Price <span class="text-danger">*</span></label>
          <input type="number" class="form-control" id="f-price" placeholder="0" min="0" step="0.01">
        </div>

        <!-- Discounted Price -->
        <div class="col-6 col-sm-4 col-md-2">
          <label for="f-disc">Discounted Price</label>
          <input type="number" class="form-control" id="f-disc" placeholder="0" min="0" step="0.01">
        </div>

        <!-- Piece Type -->
        <div class="col-6 col-sm-4 col-md-1">
          <label for="f-piece">Piece</label>
          <select class="form-select" id="f-piece">
            <option value="">--</option>
            <% ['1pc','2pc','3pc','4pc','5pc','6pc','7pc','8pc','9pc','10pc'].forEach(function(p){ %>
              <option value="<%= p %>"><%= p %></option>
            <% }); %>
          </select>
        </div>

        <!-- Quantity -->
        <div class="col-6 col-sm-4 col-md-1">
          <label>Qty</label>
          <div class="qty-control">
            <button class="btn btn-outline-secondary btn-sm" id="qty-dec" type="button">−</button>
            <input type="number" class="form-control" id="f-qty" value="1" min="1">
            <button class="btn btn-outline-secondary btn-sm" id="qty-inc" type="button">+</button>
          </div>
        </div>

        <!-- Add Button -->
        <div class="col-12 col-md-1 d-flex align-items-end">
          <button class="btn btn-primary w-100" id="btn-add-item" type="button">
            <i class="fa-solid fa-plus me-1"></i>Add
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- ===== RETURN MANUAL ENTRY ===== -->
  <div class="card mb-3 shadow-sm" id="return-form">
    <div class="card-header bg-dark text-white py-2 d-flex align-items-center justify-content-between">
      <span><i class="fa-solid fa-rotate-left me-2 text-warning"></i><span class="fw-semibold">Return Manual Entry</span></span>
      <button class="btn btn-sm btn-outline-light" id="btn-open-return-scan">
        <i class="fa-solid fa-camera me-1"></i>Add Return Via Scan
      </button>
    </div>
    <div class="card-body py-3">
      <div class="row g-2 align-items-end">
        <!-- Item Name (Compulsory) -->
        <div class="col-12 col-sm-6 col-md-2">
          <label class="form-label" for="r-name" style="font-size:.82rem;font-weight:600;">Item Name <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="r-name" placeholder="e.g. Shirt">
        </div>
        <!-- Category -->
        <div class="col-12 col-sm-6 col-md-2">
          <label class="form-label" for="r-category" style="font-size:.82rem;font-weight:600;">Category</label>
          <select class="form-select" id="r-category">
            <option value="">-- Select --</option>
            <% if (typeof allCategories !== 'undefined' && allCategories.length) { %>
              <% allCategories.forEach(function(cat){ %>
                <option value="<%= cat.categoryName %>"><%= cat.categoryName %></option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <!-- Price (Compulsory) -->
        <div class="col-6 col-sm-4 col-md-2">
          <label class="form-label" for="r-price" style="font-size:.82rem;font-weight:600;">Price <span class="text-danger">*</span></label>
          <input type="number" class="form-control" id="r-price" placeholder="0" min="0" step="0.01">
        </div>
        <!-- Disc Price (Optional) -->
        <div class="col-6 col-sm-4 col-md-1">
          <label class="form-label" for="r-disc" style="font-size:.82rem;font-weight:600;">Disc. Price</label>
          <input type="number" class="form-control" id="r-disc" placeholder="0" min="0" step="0.01">
        </div>
        <!-- Sold For (Optional - defaults to Price) -->
        <div class="col-6 col-sm-4 col-md-2">
          <label class="form-label" for="r-sold-for" style="font-size:.82rem;font-weight:600;">Sold For</label>
          <input type="number" class="form-control" id="r-sold-for" placeholder="Auto / Price" min="0" step="0.01">
        </div>
        <!-- Piece -->
        <div class="col-6 col-sm-4 col-md-1">
          <label class="form-label" for="r-piece" style="font-size:.82rem;font-weight:600;">Piece</label>
          <select class="form-select" id="r-piece">
            <option value="">--</option>
            <% ['1pc','2pc','3pc','4pc','5pc','6pc','7pc','8pc','9pc','10pc'].forEach(function(p){ %>
              <option value="<%= p %>"><%= p %></option>
            <% }); %>
          </select>
        </div>
        <!-- Qty -->
        <div class="col-6 col-sm-4 col-md-1">
          <label class="form-label" style="font-size:.82rem;font-weight:600;">Qty</label>
          <div class="qty-control">
            <button class="btn btn-outline-secondary btn-sm" id="r-qty-dec" type="button">&minus;</button>
            <input type="number" class="form-control" id="r-qty" value="1" min="1">
            <button class="btn btn-outline-secondary btn-sm" id="r-qty-inc" type="button">+</button>
          </div>
        </div>
        <!-- Add Button -->
        <div class="col-12 col-md-1 d-flex align-items-end">
          <button class="btn btn-warning w-100" id="btn-add-return" type="button">
            <i class="fa-solid fa-plus me-1"></i>Add
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== BILL ITEMS LIST ===== -->
  <div id="items-wrapper" class="mb-3">
    <table class="table table-sm mb-0" id="items-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Item Name</th>
          <th>Category</th>
          <th>Piece</th>
          <th>Qty</th>
          <th>Price</th>
          <th>Disc. Price</th>
          <th>Sold For</th>
          <th>Line Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="items-tbody">
        <tr id="empty-row">
          <td colspan="10" class="text-center text-muted py-3">
            <i class="fa-solid fa-cart-plus me-2"></i>No items added yet
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- ===== PRINT SIZE (above actions) ===== -->
  <div class="card shadow-sm mb-2">
    <div class="card-body py-2 bg-light d-flex align-items-center gap-3">
      <span class="fw-semibold small">Print Size:</span>
      <div class="btn-group" id="print-size-group" role="group">
        <button type="button" class="btn btn-sm btn-dark active" data-size="3inch">3 Inch</button>
        <button type="button" class="btn btn-sm btn-outline-dark" data-size="4inch">4 Inch</button>
      </div>
    </div>
  </div>

  <!-- ===== BOTTOM ACTIONS ===== -->
  <div class="card shadow-sm">
    <div class="card-body bg-dark rounded d-flex flex-wrap align-items-center gap-2">
      <button class="btn btn-success" id="btn-save-print" type="button">
        <i class="fa-solid fa-print me-2"></i>Save & Print Slip
      </button>
      <button class="btn btn-danger" id="btn-download-pdf" type="button">
        <i class="fa-solid fa-file-pdf me-2"></i>Download PDF
      </button>
      <button class="btn btn-info text-white" id="btn-download-img" type="button">
        <i class="fa-solid fa-image me-2"></i>Download Image
      </button>
    </div>
  </div>

</div><!-- /bill-page -->

<!-- ===== CAMERA OVERLAY ===== -->
<div id="camera-overlay">
  <div id="qr-reader"></div>
  <div id="scan-status">Point camera at a QR code…</div>
  <button class="btn btn-danger mt-3" id="btn-stop-scan">
    <i class="fa-solid fa-stop me-2"></i>Stop Scanning
  </button>
</div>

<!-- Flash on scan -->
<div id="scan-flash"></div>

<!-- ===== RETURN CAMERA OVERLAY ===== -->
<div id="return-camera-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:9999;flex-direction:column;align-items:center;justify-content:center;">
  <div style="color:#ffc107;font-weight:bold;margin-bottom:10px;font-size:1rem;"><i class="fa-solid fa-rotate-left me-2"></i>Return Scanning Mode</div>
  <div id="return-qr-reader" style="width:min(94vw,420px);border-radius:10px;overflow:hidden;background:#000;"></div>
  <div id="return-scan-status" style="margin-top:14px;font-size:.95rem;color:#fff;min-height:28px;text-align:center;">Point camera at barcode…</div>
  <button class="btn btn-danger mt-3" id="btn-stop-return-scan">
